---
/** Renders an icon from src/icons/icons.ts, e.g. <Icon name="lock" /> */
import { iconSvg } from '../icons/svg';
import type { IconName } from '../icons/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'icon' } = Astro.props;
---

<Fragment set:html={iconSvg(name, className)} />
