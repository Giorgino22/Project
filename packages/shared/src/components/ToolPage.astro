---
/**
 * Template for a tool page: title + short intro, the tool itself (passed in as the
 * default slot), then "how it works", FAQ and links to the site's other tools.
 * The tool comes FIRST, right below the heading – visitors came to use it, not to read.
 */
import { defaultLang, frameTexts, type Alternate, type Lang } from '../i18n';
import { siteUrl, type SiteId } from '../network';
import { faqSchema, webApplicationSchema } from '../lib/seo';
import AdSlot from './AdSlot.astro';
import SiteLayout from './SiteLayout.astro';

export interface ToolPageData {
  path: string;
  /** Short name for menus and "more tools" links */
  name: string;
  /** One line under the name in "more tools" lists, e.g. "Spin for a random yes or no." */
  short?: string;
  /** Browser tab / Google headline (≤ ~60 characters) */
  title: string;
  /** Google snippet (≤ ~160 characters) */
  description: string;
  h1: string;
  lead: string;
  steps: string[];
  faq: { q: string; a: string }[];
}

interface Props {
  site: SiteId;
  /** Language of the page (default: English) */
  lang?: Lang;
  page: ToolPageData;
  /** All pages of the site in this language, for the header menu and the "more tools" section */
  allPages: ToolPageData[];
  /** All language versions of this page (for the language menu and search engines) */
  alternates?: Alternate[];
  /** AdSense slot IDs for this site (empty = no ad) */
  adSlots?: { afterTool?: string; beforeFaq?: string };
  /** true = no ads at all on this page. Use it for pages aimed at children: ads there need special rules. */
  noAds?: boolean;
}

const { site, lang = defaultLang, page, allPages, alternates = [], noAds = false } = Astro.props;
const text = frameTexts[lang];
const adSlots = noAds ? {} : (Astro.props.adSlots ?? {});
const url = siteUrl(site) + page.path;
const nav = allPages.map((p) => ({ href: p.path, label: p.name }));
const related = allPages.filter((p) => p.path !== page.path);
---

<SiteLayout
  site={site}
  lang={lang}
  title={page.title}
  description={page.description}
  path={page.path}
  alternates={alternates}
  nav={nav}
  noAds={noAds}
  jsonLd={[webApplicationSchema(page.name, page.description, url, lang), faqSchema(page.faq)]}
>
  <div class="container">
    <section class="page-intro compact">
      <h1>{page.h1}</h1>
      <p class="lead">{page.lead}</p>
    </section>

    <slot />

    <AdSlot slot={adSlots.afterTool ?? ''} lang={lang} />

    <section>
      <h2>{text.howItWorks}</h2>
      <ol class="steps">{page.steps.map((step) => <li>{step}</li>)}</ol>
    </section>

    <AdSlot slot={adSlots.beforeFaq ?? ''} lang={lang} />

    <section class="faq">
      <h2>{text.faq}</h2>
      {
        page.faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </section>

    {
      related.length > 0 && (
        <section>
          <h2>{text.related}</h2>
          <ul class="link-list">
            {related.map((other) => (
              <li>
                <a href={other.path}>
                  <strong>{other.name}</strong>
                  {other.short && <span>{other.short}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</SiteLayout>
