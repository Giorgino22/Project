---
/** "Did this help? Buy me a coffee" – shown after a result. Hidden while network.supportUrl is empty. */
import { features, network } from '../network';
---

{
  features.support && (
    <div class="support-box">
      <p>
        <strong>Did this help?</strong> The tools are free and stay free. If you’d like to say thanks, you can buy me a
        coffee.
      </p>
      <a class="btn btn-secondary btn-small" href={network.supportUrl} target="_blank" rel="noopener">
        Buy me a coffee
      </a>
    </div>
  )
}
