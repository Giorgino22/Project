---
/**
 * The HTML frame of every page on the new sites: everything search engines and social
 * networks read in <head>, a header, the page content and a footer that links to all
 * other sites of the network (those links help visitors – and Google – find them).
 *
 * Pages in several languages pass `alternates` (all language versions of the page). Then the
 * frame adds the hreflang links search engines need, a language menu in the header and
 * language links in the footer – the same way KeepLocal does it.
 */
import { defaultLang, fill, frameTexts, legalPaths, type Alternate, type Lang } from '../i18n';
import { features, network, sites, siteIn, siteUrl, type SiteId } from '../network';
import Icon from './Icon.astro';
import '../styles/base.css';

interface Props {
  site: SiteId;
  /** Language of this page (default: English) */
  lang?: Lang;
  /** Full text for the browser tab and the Google headline */
  title: string;
  description: string;
  /** Path of this page, e.g. "/yes-or-no-wheel/" */
  path: string;
  /** All language versions of this page, e.g. [{ lang: 'en', path: '/' }, { lang: 'de', path: '/de/' }] */
  alternates?: Alternate[];
  /** Structured data for search engines (see lib/seo.ts) */
  jsonLd?: Record<string, unknown>[];
  /** true = search engines should not index this page (404 page) */
  noindex?: boolean;
  /** Links shown in the header (other pages of this site) */
  nav?: { href: string; label: string }[];
  /** true = never load ad code on this page (e.g. pages made for children) */
  noAds?: boolean;
}

const {
  site,
  lang = defaultLang,
  title,
  description,
  path,
  alternates = [],
  jsonLd = [],
  noindex = false,
  nav = [],
  noAds = false,
} = Astro.props;
const text = frameTexts[lang];
const current = sites.find((s) => s.id === site)!;
const here = siteIn(site, lang); // name, description and start page of this site in this language
const base = siteUrl(site);
const hub = site === 'hub' ? '' : siteUrl('hub'); // '' = links within the hub stay relative
const legal = legalPaths[lang];
const others = sites.filter((s) => s.id !== site && s.id !== 'hub');
// Language menu and hreflang links only when the page really exists in more than one language.
const versions = alternates.length > 1 ? alternates : [];
const fallback = versions.find((version) => version.lang === defaultLang);
const year = new Date().getFullYear();
// JSON inside <script> must not contain "</script>", so "<" is escaped.
const toJson = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={base + path} />}
    {!noindex && versions.map((version) => <link rel="alternate" hreflang={version.lang} href={base + version.path} />)}
    {!noindex && fallback && <link rel="alternate" hreflang="x-default" href={base + fallback.path} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={here.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={base + path} />
    <meta property="og:image" content={`${base}/og-image.jpg`} />
    <meta property="og:locale" content={text.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* The browser's own bars take the page colour (light and dark mode) */}
    <meta name="theme-color" content="#fbfbf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141516" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={toJson(data)} />)}
    {
      features.ads && !noAds && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${network.adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{text.skip}</a>
    <header class="site-header">
      <div class="container">
        <a class="logo" href={here.path}><img src="/favicon.svg" width="28" height="28" alt="" />{here.name}</a>
        {
          nav.length > 0 && (
            <nav class="header-nav" aria-label={text.mainMenu}>
              {nav.map((link) => (
                <a href={link.href} aria-current={link.href === path ? 'page' : undefined}>
                  {link.label}
                </a>
              ))}
            </nav>
          )
        }
        {
          /* Outside the menu on purpose: on phones the menu scrolls sideways and would cut the list off. */
          versions.length > 0 && (
            <details class="lang-menu">
              <summary aria-label={text.language}>
                <Icon name="globe" />
                {lang.toUpperCase()}
              </summary>
              <ul>
                {versions.map((version) => (
                  <li>
                    <a
                      href={version.path}
                      hreflang={version.lang}
                      lang={version.lang}
                      aria-current={version.lang === lang ? 'page' : undefined}
                    >
                      {frameTexts[version.lang].name}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )
        }
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h2>{here.name}</h2>
            <p>{here.description}</p>
            {
              site === 'hub' && (
                <ul>
                  <li><a href={legal.privacy}>{text.privacy}</a></li>
                  <li><a href={legal.imprint}>{text.imprint}</a></li>
                </ul>
              )
            }
          </div>
          {
            nav.length > 0 && (
              <nav aria-label={fill(text.sitePages, { site: here.name })}>
                <h2>{text.toolsOnSite}</h2>
                <ul>
                  {nav.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
          {
            others.length > 0 && (
              <nav aria-label={text.moreTools}>
                <h2>{fill(text.moreFrom, { network: network.name })}</h2>
                <ul>
                  {others.map((other) => (
                    <li>
                      <a href={siteIn(other.id, lang).url}>{siteIn(other.id, lang).name}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
          {
            site !== 'hub' && (
              <div>
                <h2>{network.name}</h2>
                <ul>
                  <li><a href={siteIn('hub', lang).url}>{text.allTools}</a></li>
                  <li><a href={hub + legal.privacy}>{text.privacy}</a></li>
                  <li><a href={hub + legal.imprint}>{text.imprint}</a></li>
                </ul>
              </div>
            )
          }
        </div>
        <div class="footer-bottom">
          <span>© {year} {network.name}</span>
          <span>{current.dataNote ?? text.noUpload}</span>
          {
            versions.length > 0 && (
              <nav class="footer-languages" aria-label={text.languages}>
                {versions.map((version) => (
                  <a href={version.path} hreflang={version.lang} lang={version.lang}>
                    {frameTexts[version.lang].name}
                  </a>
                ))}
              </nav>
            )
          }
        </div>
      </div>
    </footer>
  </body>
</html>
