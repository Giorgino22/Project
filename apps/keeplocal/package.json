{
  "name": "keeplocal",
  "description": "Free, privacy-first PDF and image tools that run 100% in the browser.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-ocr-assets.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-ocr-assets.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "images": "node ../../packages/shared/scripts/og-image.mjs \"KeepLocal\" \"PDF & image tools that never upload your files.\" \"keeplocal\""
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@tools/shared": "*",
    "astro": "7.3.8",
    "exifr": "7.1.3",
    "fflate": "0.8.3",
    "html-entities": "2.6.0",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/qrcode": "1.5.6",
    "jsqr": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
