---
import { sites, siteUrl } from '@tools/shared/network';
import { config } from '../config';
import { t, type Lang } from '../i18n';
import { alternatesOf, legalPath, toolPath, toolText } from '../site/pages';
import { categories, tools } from '../tools/registry';

interface Props {
  lang: Lang;
  pageKey: string;
}

const { lang, pageKey } = Astro.props;
const dict = t(lang);
const year = new Date().getFullYear();
// The other websites of the network (they are listed in packages/shared/src/network.ts).
const sisterSites = sites.filter((site) => site.id !== 'keeplocal' && site.id !== 'hub');
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      {
        categories.map((category) => (
          <nav aria-label={dict.categories[category]}>
            <h2>{dict.categories[category]}</h2>
            <ul>
              {tools
                .filter((tool) => tool.category === category)
                .map((tool) => (
                  <li>
                    <a href={toolPath(tool.id, lang)}>{toolText(tool.id, lang).name}</a>
                  </li>
                ))}
            </ul>
          </nav>
        ))
      }
      <nav aria-label={dict.footer.moreTools}>
        <h2>{dict.footer.moreTools}</h2>
        <ul>
          {
            sisterSites.map((site) => (
              <li>
                <a href={`${siteUrl(site.id)}/`}>{site.name}</a>
              </li>
            ))
          }
          <li><a href={`${siteUrl('hub')}/`}>{dict.footer.allTools}</a></li>
        </ul>
      </nav>
      <div>
        <h2>{config.siteName}</h2>
        <p>{dict.footer.about}</p>
        <ul>
          <li><a href={legalPath('privacy', lang)}>{dict.footer.privacy}</a></li>
          <li><a href={legalPath('imprint', lang)}>{dict.footer.imprint}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {config.siteName}</span>
      <nav class="footer-languages" aria-label={dict.footer.languages}>
        {
          alternatesOf(pageKey).map((version) => (
            <a href={version.path} hreflang={version.lang} lang={version.lang}>
              {t(version.lang).name}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
