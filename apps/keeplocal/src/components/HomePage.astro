---
import { config } from '../config';
import { t, type Lang } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fill } from '../lib/format';
import { absoluteUrl, homePath, toolPath, toolText } from '../site/pages';
import { faqSchema, websiteSchema } from '../site/seo';
import { categories, tools } from '../tools/registry';
import Icon from '@tools/shared/components/Icon.astro';
import MergeDemo from './MergeDemo.astro';
import ToolCard from './ToolCard.astro';
import '../styles/keeplocal.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const path = homePath(lang);
const converterPages = tools.filter((tool) => 'convert' in tool);
---

<BaseLayout
  lang={lang}
  title={fill(dict.home.title, { site: config.siteName })}
  description={dict.home.description}
  pageKey="home"
  path={path}
  jsonLd={[websiteSchema(absoluteUrl(path), dict.home.description, lang), faqSchema(dict.home.faq)]}
>
  <div class="container">
    <section class="home-hero">
      <div>
        <h1 class="display">{dict.home.h1}</h1>
        <p class="lead">{dict.home.lead}</p>
      </div>
      <MergeDemo lang={lang} />
    </section>

    {
      categories.map((category) => (
        <section id={category} class="tool-section">
          <h2>{dict.categories[category]}</h2>
          <p class="section-intro">{dict.categoryIntros[category]}</p>
          <ul class="tool-grid">
            {tools
              .filter((tool) => tool.category === category && !('convert' in tool))
              .map((tool) => (
                <li>
                  <ToolCard toolId={tool.id} lang={lang} />
                </li>
              ))}
          </ul>
          {category === 'image' && (
            <ul class="chip-list">
              {converterPages.map((tool) => (
                <li>
                  <a href={toolPath(tool.id, lang)}>{toolText(tool.id, lang).name}</a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    <section class="callout">
      <Icon name="eye" />
      <div>
        <h2>{dict.home.verifyTitle}</h2>
        <p>{dict.home.verifyText}</p>
      </div>
    </section>

    <section class="faq">
      <h2>{dict.home.faqTitle}</h2>
      {
        dict.home.faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </section>
  </div>
</BaseLayout>
