---
import { config } from '../config';
import { t, type Lang } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fill } from '../lib/format';
import { absoluteUrl, homePath, toolPath, toolText } from '../site/pages';
import { faqSchema, websiteSchema } from '../site/seo';
import { categories, tools } from '../tools/registry';
import Icon from './Icon.astro';
import ToolCard from './ToolCard.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const path = homePath(lang);
const featureIcons = ['lock', 'heart-handshake', 'wand-sparkles'] as const;
const converterPages = tools.filter((tool) => 'convert' in tool);
---

<BaseLayout
  lang={lang}
  title={fill(dict.home.title, { site: config.siteName })}
  description={dict.home.description}
  pageKey="home"
  path={path}
  jsonLd={[websiteSchema(absoluteUrl(path), dict.home.description, lang), faqSchema(dict.home.faq)]}
>
  <div class="container">
    <section class="page-intro">
      <h1>{dict.home.h1}</h1>
      <p class="lead">{dict.home.lead}</p>
      <span class="badge"><Icon name="lock" /> {dict.badge}</span>
    </section>

    {
      categories.map((category) => (
        <section id={category}>
          <h2>{dict.categories[category]}</h2>
          <p>{dict.categoryIntros[category]}</p>
          <ul class="tool-grid">
            {tools
              .filter((tool) => tool.category === category && !('convert' in tool))
              .map((tool) => (
                <li>
                  <ToolCard toolId={tool.id} lang={lang} />
                </li>
              ))}
          </ul>
          {category === 'image' && (
            <ul class="chip-list">
              {converterPages.map((tool) => (
                <li>
                  <a href={toolPath(tool.id, lang)}>{toolText(tool.id, lang).name}</a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    <div class="feature-grid">
      {
        dict.home.features.map((feature, index) => (
          <div class="card">
            <h3>
              <Icon name={featureIcons[index] ?? 'check'} />
              {feature.title}
            </h3>
            <p>{feature.text}</p>
          </div>
        ))
      }
    </div>

    <section class="callout">
      <Icon name="eye" />
      <div>
        <h2 style="margin: 0 0 4px; font-size: 1.05rem">{dict.home.verifyTitle}</h2>
        <p>{dict.home.verifyText}</p>
      </div>
    </section>

    <section class="faq">
      <h2>{dict.home.faqTitle}</h2>
      {
        dict.home.faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </section>
  </div>
</BaseLayout>
