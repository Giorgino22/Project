---
/**
 * Password card: a printable grid of random characters (logic: src/lib/password-card.ts).
 * The card is made in the browser only – the HTML from the server contains an empty table,
 * otherwise every visitor would get the same "random" card.
 */
import { t, type Lang } from '../../i18n';
import type { ToolDefinition } from '../../tools/registry';
import Icon from '@tools/shared/components/Icon.astro';
import StatusLine from '../StatusLine.astro';
import SupportBox from '../SupportBox.astro';
import ToolShell from './ToolShell.astro';

interface Props {
  lang: Lang;
  tool: ToolDefinition;
}

const { lang } = Astro.props;
const dict = t(lang).components;
const text = dict.PasswordCard;
// Same character choices as the password generator (and the same labels).
// Look-alikes are left out by default: on paper, l/I/1 and O/0 are easily confused.
const characterTypes = [
  ['lowercase', dict.PasswordGenerator.lowercase, true],
  ['uppercase', dict.PasswordGenerator.uppercase, true],
  ['digits', dict.PasswordGenerator.digits, true],
  ['symbols', dict.PasswordGenerator.symbols, true],
  ['avoidAmbiguous', dict.PasswordGenerator.avoidAmbiguous, true],
] as const;
---

<ToolShell lang={lang} component="PasswordCard">
  <div class="options">
    <fieldset class="field">
      <legend>{text.sizeLabel}</legend>
      <div class="segmented">
        {
          (
            [
              ['wallet', text.sizeWallet],
              ['a4', text.sizeA4],
            ] as const
          ).map(([value, label]) => (
            <label>
              <input type="radio" name="size" value={value} checked={value === 'wallet'} />
              <span>{label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset class="field">
      <legend>{dict.PasswordGenerator.charactersLabel}</legend>
      {
        characterTypes.map(([name, label, on]) => (
          <label class="choice">
            <input type="checkbox" name={name} checked={on} />
            {label}
          </label>
        ))
      }
    </fieldset>
  </div>

  <div class="pw-card-frame">
    <table class="pw-card" data-card data-size="wallet"></table>
  </div>
  <p class="field-help pw-card-entropy" data-entropy></p>
  <StatusLine />

  <div class="actions">
    <button type="button" class="btn btn-primary" data-print>
      <Icon name="printer" />
      {text.print}
    </button>
    <button type="button" class="btn btn-secondary" data-new>
      <Icon name="refresh-cw" />
      {text.newCard}
    </button>
  </div>
  <p class="field-help pw-card-hint">{text.printHint}</p>
  <div data-support hidden><SupportBox lang={lang} /></div>
</ToolShell>

<style is:global>
  /* Global (not scoped) because the print copy of the card is created by the script.
     All class names start with "pw-card" / "pw-print" so they can't clash with others. */

  .pw-card-frame {
    margin-top: 24px;
    padding: 16px;
    overflow-x: auto; /* the A4 grid is wider than a phone: it scrolls inside the frame */
    border-radius: 12px;
    background: var(--sheet);
  }

  .pw-card {
    margin: 0 auto;
    border-collapse: collapse;
    font-family: var(--mono);
    font-size: 1.0625rem;
    text-align: center;
  }

  .pw-card th,
  .pw-card td {
    min-width: 1.7em;
    padding: 4px 2px;
  }

  /* Column letters and row numbers */
  .pw-card th {
    color: var(--pencil);
    font-family: var(--font);
    font-size: 0.8125rem;
    font-weight: 650;
  }

  /* Every other row slightly darker, so the eye stays in its row */
  .pw-card tbody tr:nth-child(odd) td {
    background: var(--desk);
  }

  .pw-card-entropy {
    margin: 12px 0 0;
  }

  .pw-card-hint {
    margin: 12px 0 0;
  }

  /* The copy for the printer (see the script). It only exists while printing. */
  @media screen {
    .pw-print-sheet {
      display: none;
    }
  }

  @media print {
    @page {
      margin: 12mm;
    }

    /* Print nothing but the card. */
    body > :not(.pw-print-sheet) {
      display: none !important;
    }

    body {
      background: #fff;
    }

    .pw-print-sheet .pw-card {
      width: 100%;
      height: 100%;
      table-layout: fixed;
      color: #000;
      /* Print the grey rows, even if the browser normally leaves out backgrounds. */
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .pw-print-sheet .pw-card th,
    .pw-print-sheet .pw-card td {
      min-width: 0;
      padding: 0;
    }

    .pw-print-sheet .pw-card th {
      color: #555;
    }

    .pw-print-sheet .pw-card tbody tr:nth-child(odd) td {
      background: #e6e6e6;
    }

    /* Wallet card: exactly bank-card size, with a dashed line to cut along. */
    .pw-card-cut[data-size='wallet'] {
      width: 85.6mm;
      height: 53.98mm;
      padding: 1.5mm;
      border: 0.3mm dashed #000;
      break-inside: avoid;
    }

    .pw-card-cut[data-size='wallet'] .pw-card {
      font-size: 8pt;
    }

    .pw-card-cut[data-size='wallet'] .pw-card th {
      font-size: 6pt;
    }

    /* A4: the grid fills the page with large, easy-to-read characters. */
    .pw-card-cut[data-size='a4'] {
      width: 100%;
      height: 265mm;
    }

    .pw-card-cut[data-size='a4'] .pw-card {
      font-size: 13pt;
    }

    .pw-card-cut[data-size='a4'] .pw-card th {
      font-size: 9pt;
    }
  }
</style>

<script>
  import type { Dictionary } from '../../i18n/en';
  import { fill } from '../../lib/format';
  import { bitsPerCharacter, CARD_SIZES, columnLabels, generateCard, type CardOptions, type CardSize } from '../../lib/password-card';
  import { $, radioValue, readTexts, Status, toolRoots } from '../../scripts/ui';

  type Texts = Dictionary['common'] & Dictionary['components']['PasswordCard'];

  /** A table cell with text in it (as text, never as HTML). */
  function cell(tag: 'th' | 'td', content: string, scope?: 'col' | 'row'): HTMLTableCellElement {
    const element = document.createElement(tag);
    element.textContent = content;
    if (scope) element.scope = scope;
    return element;
  }

  for (const root of toolRoots('PasswordCard')) {
    const t = readTexts<Texts>(root);
    const status = new Status($(root, '[data-status]'));
    const table = $<HTMLTableElement>(root, '[data-card]');
    const printButton = $<HTMLButtonElement>(root, '[data-print]');
    const checked = (name: string) => $<HTMLInputElement>(root, `input[name="${name}"]`).checked;
    const number = new Intl.NumberFormat(root.dataset.lang, { maximumFractionDigits: 1 });

    function readOptions(): CardOptions {
      return {
        lowercase: checked('lowercase'),
        uppercase: checked('uppercase'),
        digits: checked('digits'),
        symbols: checked('symbols'),
        avoidAmbiguous: checked('avoidAmbiguous'),
      };
    }

    /** Draws a brand-new random card. */
    function newCard(): void {
      const size = radioValue(root, 'size') as CardSize;
      const options = readOptions();
      let card: string[][];
      try {
        card = generateCard(size, options);
      } catch {
        table.replaceChildren();
        $(root, '[data-entropy]').textContent = '';
        printButton.disabled = true;
        status.set(t.needOneType, 'error');
        return;
      }
      status.clear();
      printButton.disabled = false;

      const { rows, columns } = CARD_SIZES[size];
      const head = document.createElement('thead');
      const headRow = head.insertRow();
      headRow.append(cell('th', ''), ...columnLabels(columns).map((label) => cell('th', label, 'col')));
      const body = document.createElement('tbody');
      card.forEach((characters, index) => {
        const row = body.insertRow();
        row.append(cell('th', String(index + 1), 'row'), ...characters.map((character) => cell('td', character)));
      });
      table.replaceChildren(head, body);
      table.dataset.size = size;
      table.setAttribute('aria-label', fill(t.tableLabel, { rows, columns }));

      const bits = bitsPerCharacter(options);
      $(root, '[data-entropy]').textContent = fill(t.entropy, { bits: number.format(bits), total: Math.round(bits * 12) });
    }

    root.addEventListener('input', newCard);
    $(root, '[data-new]').addEventListener('click', newCard);
    printButton.addEventListener('click', () => {
      window.print();
      root.querySelector<HTMLElement>('[data-support]')?.removeAttribute('hidden');
    });

    // Printing (with the button or Ctrl+P): the print CSS hides the whole page except a copy of
    // the card, which we add to <body> just before printing and remove afterwards.
    let sheet: HTMLElement | undefined;
    window.addEventListener('beforeprint', () => {
      sheet?.remove();
      if (!table.rows.length) return;
      sheet = document.createElement('div');
      sheet.className = 'pw-print-sheet';
      const cut = document.createElement('div');
      cut.className = 'pw-card-cut';
      cut.dataset.size = table.dataset.size;
      cut.append(table.cloneNode(true));
      sheet.append(cut);
      document.body.append(sheet);
    });
    window.addEventListener('afterprint', () => sheet?.remove());

    newCard();
  }
</script>
