---
import { t, type Lang } from '../../i18n';
import type { ToolDefinition } from '../../tools/registry';
import FileDrop from '../FileDrop.astro';
import PageSelector from '../PageSelector.astro';
import PasswordPrompt from '../PasswordPrompt.astro';
import Results from '../Results.astro';
import StatusLine from '../StatusLine.astro';
import ToolShell from './ToolShell.astro';

interface Props {
  lang: Lang;
  tool: ToolDefinition;
}

const { lang } = Astro.props;
const text = t(lang).components.RotatePdf;
---

<ToolShell lang={lang} component="RotatePdf">
  <FileDrop lang={lang} accept="application/pdf,.pdf" />
  <p class="file-info" data-file-info hidden></p>
  <PasswordPrompt lang={lang} />
  <div class="options" data-options hidden>
    <fieldset class="field">
      <legend>{text.directionLabel}</legend>
      <div class="segmented">
        <label><input type="radio" name="angle" value="90" checked /><span>↻ {text.right}</span></label>
        <label><input type="radio" name="angle" value="270" /><span>↺ {text.left}</span></label>
        <label><input type="radio" name="angle" value="180" /><span>{text.flip}</span></label>
      </div>
    </fieldset>
    <PageSelector lang={lang} legend={text.pagesLabel} allowAll />
  </div>
  <div class="actions">
    <button type="button" class="btn btn-primary" data-run disabled>{text.button}</button>
  </div>
  <StatusLine />
  <Results lang={lang} />
</ToolShell>

<script>
  import type { PDFDocument } from '@cantoo/pdf-lib';
  import type { Dictionary } from '../../i18n/en';
  import { formatBytes, outputName } from '../../lib/format';
  import type { RotationAngle } from '../../lib/pdf-ops';
  import { setupFileDrop } from '../../scripts/file-drop';
  import { openPdfFile, PasswordPrompt } from '../../scripts/pdf-open';
  import { Results } from '../../scripts/results';
  import {
    $,
    bytesToBlob,
    describeError,
    pagesLabel,
    radioValue,
    readTexts,
    runTask,
    selectedPages,
    setupPageSelector,
    Status,
    toolRoots,
  } from '../../scripts/ui';

  type Texts = Dictionary['common'] & Dictionary['components']['RotatePdf'];

  for (const root of toolRoots('RotatePdf')) {
    const t = readTexts<Texts>(root);
    const lang = root.dataset.lang ?? 'en';
    const status = new Status($(root, '[data-status]'));
    const button = $<HTMLButtonElement>(root, '[data-run]');
    const fileInfo = $(root, '[data-file-info]');
    const options = $(root, '[data-options]');
    const prompt = new PasswordPrompt(root);
    let current: { file: File; doc: PDFDocument } | undefined;

    /** Shows or hides the file info, the options and the button. */
    const setLoaded = (loaded: boolean) => {
      fileInfo.hidden = !loaded;
      options.hidden = !loaded;
      button.disabled = !loaded;
    };
    const results = new Results(root, t, lang, {
      zipName: 'rotated.zip',
      onStartOver: () => {
        current = undefined;
        setLoaded(false);
        status.clear();
      },
    });
    setupPageSelector(root);

    setupFileDrop(root, async ([file]) => {
      if (!file) return;
      results.clear();
      status.clear();
      try {
        const doc = await openPdfFile(file, prompt, t);
        current = { file, doc };
        fileInfo.textContent = `${file.name} · ${pagesLabel(doc.getPageCount(), t)} · ${formatBytes(file.size, lang)}`;
        setLoaded(true);
      } catch (error) {
        status.set(describeError(error, t), 'error');
      }
    });

    button.addEventListener('click', () =>
      runTask(button, status, t, async () => {
        if (!current) return;
        const { rotatePages } = await import('../../lib/pdf-ops');
        const angle = Number(radioValue(root, 'angle')) as RotationAngle;
        const pages = selectedPages(root, current.doc.getPageCount());
        const bytes = await rotatePages(current.doc, pages, angle);
        results.show([{ name: outputName(current.file.name, 'pdf', '_rotated'), blob: bytesToBlob(bytes, 'application/pdf') }]);
        status.set(t.done, 'success');
      }),
    );
  }
</script>
