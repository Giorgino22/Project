---
import { t, type Lang } from '../../i18n';
import type { ToolDefinition } from '../../tools/registry';
import FileDrop from '../FileDrop.astro';
import PasswordPrompt from '../PasswordPrompt.astro';
import Results from '../Results.astro';
import StatusLine from '../StatusLine.astro';
import ToolShell from './ToolShell.astro';

interface Props {
  lang: Lang;
  tool: ToolDefinition;
}

const { lang } = Astro.props;
const text = t(lang).components.MergePdf;
---

<ToolShell lang={lang} component="MergePdf">
  <FileDrop lang={lang} accept="application/pdf,.pdf" multiple />
  <ol class="file-list" data-file-list></ol>
  <PasswordPrompt lang={lang} />
  <div class="actions">
    <button type="button" class="btn btn-primary" data-run disabled>{text.button}</button>
  </div>
  <StatusLine />
  <Results lang={lang} />
</ToolShell>

<script>
  import type { PDFDocument } from '@cantoo/pdf-lib';
  import type { Dictionary } from '../../i18n/en';
  import { fill, formatBytes } from '../../lib/format';
  import { setupFileDrop } from '../../scripts/file-drop';
  import { FileListView } from '../../scripts/file-list';
  import { openPdfFile, PasswordPrompt } from '../../scripts/pdf-open';
  import { Results } from '../../scripts/results';
  import { $, bytesToBlob, describeError, pagesLabel, readTexts, runTask, Status, toolRoots } from '../../scripts/ui';

  type Texts = Dictionary['common'] & Dictionary['components']['MergePdf'];

  for (const root of toolRoots('MergePdf')) {
    const t = readTexts<Texts>(root);
    const lang = root.dataset.lang ?? 'en';
    const status = new Status($(root, '[data-status]'));
    const button = $<HTMLButtonElement>(root, '[data-run]');
    const prompt = new PasswordPrompt(root);

    // The chosen PDFs, already opened (so we know their page count and any password was asked for).
    const list = new FileListView<{ file: File; meta: string; doc: PDFDocument }>($(root, '[data-file-list]'), t, () => {
      button.disabled = list.items.length < 2;
      results.clear();
    });
    const results = new Results(root, t, lang, {
      zipName: 'merged.zip',
      onStartOver: () => {
        list.clear();
        status.clear();
      },
    });

    setupFileDrop(root, async (files) => {
      status.clear();
      for (const file of files) {
        try {
          const doc = await openPdfFile(file, prompt, t);
          list.add([{ file, doc, meta: `${pagesLabel(doc.getPageCount(), t)}, ${formatBytes(file.size, lang)}` }]);
        } catch (error) {
          status.set(describeError(error, t), 'error');
        }
      }
      if (list.items.length === 1) status.set(t.needTwo);
    });

    button.addEventListener('click', () =>
      runTask(button, status, t, async () => {
        const { mergePdfs } = await import('../../lib/pdf-ops');
        const docs = list.items.map((item) => item.doc);
        const bytes = await mergePdfs(docs);
        const pages = docs.reduce((sum, doc) => sum + doc.getPageCount(), 0);
        results.show([{ name: 'merged.pdf', blob: bytesToBlob(bytes, 'application/pdf') }]);
        status.set(fill(t.result, { pages: pagesLabel(pages, t) }), 'success');
      }),
    );
  }
</script>
