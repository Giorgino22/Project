---
import { t, type Lang } from '../../i18n';
import type { ToolDefinition } from '../../tools/registry';
import FileDrop from '../FileDrop.astro';
import PageSelector from '../PageSelector.astro';
import PasswordPrompt from '../PasswordPrompt.astro';
import Results from '../Results.astro';
import StatusLine from '../StatusLine.astro';
import ToolShell from './ToolShell.astro';

interface Props {
  lang: Lang;
  tool: ToolDefinition;
}

const { lang } = Astro.props;
const text = t(lang).components.DeletePdfPages;
---

<ToolShell lang={lang} component="DeletePdfPages">
  <FileDrop lang={lang} accept="application/pdf,.pdf" />
  <p class="file-info" data-file-info hidden></p>
  <PasswordPrompt lang={lang} />
  <div class="options" data-options hidden>
    <PageSelector lang={lang} legend={text.pagesLabel} />
  </div>
  <div class="actions">
    <button type="button" class="btn btn-primary" data-run disabled>{text.button}</button>
  </div>
  <StatusLine />
  <Results lang={lang} />
</ToolShell>

<script>
  import type { PDFDocument } from '@cantoo/pdf-lib';
  import type { Dictionary } from '../../i18n/en';
  import { fill, formatBytes, outputName } from '../../lib/format';
  import { setupFileDrop } from '../../scripts/file-drop';
  import { openPdfFile, PasswordPrompt } from '../../scripts/pdf-open';
  import { Results } from '../../scripts/results';
  import { $, bytesToBlob, describeError, pagesLabel, readTexts, runTask, selectedPages, Status, toolRoots, UserError } from '../../scripts/ui';

  type Texts = Dictionary['common'] & Dictionary['components']['DeletePdfPages'];

  for (const root of toolRoots('DeletePdfPages')) {
    const t = readTexts<Texts>(root);
    const lang = root.dataset.lang ?? 'en';
    const status = new Status($(root, '[data-status]'));
    const button = $<HTMLButtonElement>(root, '[data-run]');
    const fileInfo = $(root, '[data-file-info]');
    const options = $(root, '[data-options]');
    const prompt = new PasswordPrompt(root);
    let current: { file: File; doc: PDFDocument } | undefined;

    /** Shows or hides the file info, the options and the button. */
    const setLoaded = (loaded: boolean) => {
      fileInfo.hidden = !loaded;
      options.hidden = !loaded;
      button.disabled = !loaded;
    };
    const results = new Results(root, t, lang, {
      zipName: 'edited.zip',
      onStartOver: () => {
        current = undefined;
        setLoaded(false);
        status.clear();
      },
    });

    setupFileDrop(root, async ([file]) => {
      if (!file) return;
      results.clear();
      status.clear();
      try {
        const doc = await openPdfFile(file, prompt, t);
        current = { file, doc };
        fileInfo.textContent = `${file.name} · ${pagesLabel(doc.getPageCount(), t)} · ${formatBytes(file.size, lang)}`;
        setLoaded(true);
      } catch (error) {
        status.set(describeError(error, t), 'error');
      }
    });

    button.addEventListener('click', () =>
      runTask(button, status, t, async () => {
        if (!current) return;
        const { deletePages } = await import('../../lib/pdf-ops');
        const pageCount = current.doc.getPageCount();
        const toDelete = selectedPages(root, pageCount);
        if (toDelete.length >= pageCount) throw new UserError(t.cannotDeleteAll);
        const bytes = await deletePages(current.doc, toDelete);
        results.show([{ name: outputName(current.file.name, 'pdf', '_edited'), blob: bytesToBlob(bytes, 'application/pdf') }]);
        status.set(fill(t.result, { pages: pagesLabel(pageCount - toDelete.length, t) }), 'success');
      }),
    );
  }
</script>
