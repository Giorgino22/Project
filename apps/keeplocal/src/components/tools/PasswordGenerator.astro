---
import { t, type Lang } from '../../i18n';
import type { ToolDefinition } from '../../tools/registry';
import Icon from '@tools/shared/components/Icon.astro';
import SupportBox from '../SupportBox.astro';
import ToolShell from './ToolShell.astro';

interface Props {
  lang: Lang;
  tool: ToolDefinition;
}

const { lang } = Astro.props;
const text = t(lang).components.PasswordGenerator;
const characterTypes = [
  ['lowercase', text.lowercase, true],
  ['uppercase', text.uppercase, true],
  ['digits', text.digits, true],
  ['symbols', text.symbols, true],
  ['avoidAmbiguous', text.avoidAmbiguous, false],
] as const;
---

<ToolShell lang={lang} component="PasswordGenerator">
  <div class="password-output">
    <output data-password aria-live="polite"></output>
    <button type="button" class="btn btn-secondary" data-copy>
      <Icon name="copy" />
      <span data-copy-label>{text.copy}</span>
    </button>
  </div>
  <div class="field" style="margin-top: 12px">
    <span class="field-label">
      {text.strengthLabel}: <span data-strength-label></span>
      <span class="field-help" data-entropy></span>
    </span>
    <div class="strength-meter" data-strength-meter><span></span></div>
  </div>

  <div class="options">
    <div class="field">
      <label class="field-label" for="password-length">{text.lengthLabel}</label>
      <div class="range-row">
        <input id="password-length" type="range" min="8" max="64" value="20" />
        <output for="password-length" data-length-value>20</output>
      </div>
    </div>
    <fieldset class="field">
      <legend>{text.charactersLabel}</legend>
      {
        characterTypes.map(([name, label, on]) => (
          <label class="choice">
            <input type="checkbox" name={name} checked={on} />
            {label}
          </label>
        ))
      }
    </fieldset>
  </div>

  <div class="actions">
    <button type="button" class="btn btn-primary" data-generate>
      <Icon name="refresh-cw" />
      {text.generate}
    </button>
  </div>
  <p class="status" data-status role="status" aria-live="polite"></p>
  <div data-support hidden><SupportBox lang={lang} /></div>
</ToolShell>

<script>
  import type { Dictionary } from '../../i18n/en';
  import { fill } from '../../lib/format';
  import { entropyBits, generatePassword, strengthOf, type PasswordOptions } from '../../lib/password';
  import { $, readTexts, Status, toolRoots } from '../../scripts/ui';

  type Texts = Dictionary['common'] & Dictionary['components']['PasswordGenerator'];

  for (const root of toolRoots('PasswordGenerator')) {
    const t = readTexts<Texts>(root);
    const status = new Status($(root, '[data-status]'));
    const output = $(root, '[data-password]');
    const length = $<HTMLInputElement>(root, '#password-length');
    const lengthValue = $(root, '[data-length-value]');
    const meter = $(root, '[data-strength-meter]');
    const copyLabel = $(root, '[data-copy-label]');
    const checked = (name: string) => $<HTMLInputElement>(root, `input[name="${name}"]`).checked;

    function readOptions(): PasswordOptions {
      return {
        length: Number(length.value),
        lowercase: checked('lowercase'),
        uppercase: checked('uppercase'),
        digits: checked('digits'),
        symbols: checked('symbols'),
        avoidAmbiguous: checked('avoidAmbiguous'),
      };
    }

    function generate(): void {
      const options = readOptions();
      lengthValue.textContent = length.value;
      try {
        output.textContent = generatePassword(options);
        status.clear();
      } catch {
        output.textContent = '';
        status.set(t.needOneType, 'error');
      }
      const bits = entropyBits(options);
      const strength = strengthOf(bits);
      meter.dataset.strength = strength;
      meter.querySelector('span')!.style.width = `${Math.min(100, (bits / 128) * 100)}%`;
      $(root, '[data-strength-label]').textContent = t.strengths[strength];
      $(root, '[data-entropy]').textContent = `(${fill(t.entropy, { bits })})`;
    }

    root.addEventListener('input', generate);
    $(root, '[data-generate]').addEventListener('click', generate);
    $(root, '[data-copy]').addEventListener('click', async () => {
      const password = output.textContent ?? '';
      if (!password) return;
      try {
        await navigator.clipboard.writeText(password);
        copyLabel.textContent = t.copied;
        setTimeout(() => (copyLabel.textContent = t.copy), 1500);
      } catch {
        // Clipboard blocked? Select the text so the visitor can copy it with Ctrl+C.
        getSelection()?.selectAllChildren(output);
      }
      root.querySelector<HTMLElement>('[data-support]')?.removeAttribute('hidden');
    });

    generate(); // first password right away
  }
</script>
