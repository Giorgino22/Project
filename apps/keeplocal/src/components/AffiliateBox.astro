---
/**
 * Affiliate recommendations configured in src/config.ts → affiliates.
 * Marked as an ad (required by law in many countries) and with rel="sponsored",
 * which tells search engines it's a paid link.
 */
import { config } from '../config';
import { t, type Lang } from '../i18n';
import type { ToolId } from '../tools/registry';

interface Props {
  lang: Lang;
  toolId: ToolId;
}

const { lang, toolId } = Astro.props;
const offers = config.affiliates
  .filter((offer) => offer.url.trim() !== '' && offer.tools.includes(toolId))
  .map((offer) => ({ url: offer.url, text: offer.text[lang] }))
  .filter((offer) => offer.text !== undefined);
---

{
  offers.map((offer) => (
    <aside class="affiliate-box card">
      <span class="ad-label">{t(lang).ads.affiliateLabel}</span>
      <h2>{offer.text!.title}</h2>
      <p>{offer.text!.body}</p>
      <a class="btn btn-primary btn-small" href={offer.url} target="_blank" rel="sponsored noopener">
        {offer.text!.button}
      </a>
    </aside>
  ))
}
