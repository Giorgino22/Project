---
/** Inline password question for protected PDFs. Behaviour: src/scripts/pdf-open.ts */
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const dict = t(Astro.props.lang).common;
---

<form class="password-prompt" data-password-prompt hidden>
  <p data-password-message role="alert"></p>
  <div class="field">
    <label class="field-label" for="pdf-password">{dict.passwordLabel}</label>
    <input id="pdf-password" type="password" autocomplete="off" />
  </div>
  <button type="submit" class="btn btn-primary btn-small">{dict.passwordSubmit}</button>
  <button type="button" class="btn btn-secondary btn-small" data-password-cancel>{dict.cancel}</button>
</form>
