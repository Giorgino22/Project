# HTTP headers for the pages of this site (https://developers.cloudflare.com/workers/static-assets/headers/)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  # Unlike the other sites, Humm may use the microphone – but only on its own pages (self)
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=()
  # Browsers remember for a year to always use the secure https:// connection for this site
  Strict-Transport-Security: max-age=31536000

# Files with a content hash or version in their path never change → browsers may cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
