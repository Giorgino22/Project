---
/**
 * The song finder: record a tune (the melody is drawn on a staff while you hum), add what you
 * remember, get up to five songs with previews, and search again until it's the right one.
 * The behaviour is in the <script> at the bottom – it runs in the visitor's browser and talks
 * to our Worker (src/worker/) at /api/identify.
 */
import Icon from '@tools/shared/components/Icon.astro';
import SupportBox from '@tools/shared/components/SupportBox.astro';
import { siteUrl } from '@tools/shared/network';
import { MAX_SECONDS } from '../scripts/recording';

const privacyUrl = `${siteUrl('hub')}/privacy/#song-finder`;
---

<div class="humm card" data-humm>
  <div class="humm-top">
    <div class="humm-stage">
      <!-- The staff: the melody is drawn here while recording. It's a picture only, so screen readers skip it. -->
      <canvas class="staff" data-staff aria-hidden="true"></canvas>
      <p class="staff-legend" data-legend hidden><span class="staff-legend-mark" aria-hidden="true"></span>Red: no tune heard (silence)</p>
      <div class="record-row">
        <button type="button" class="record-key" data-record aria-pressed="false" aria-label="Start recording">
          <span data-mic-icon><Icon name="mic" /></span>
          <span data-stop-icon hidden><Icon name="square" /></span>
        </button>
        <div>
          <p class="record-time readout" aria-hidden="true">
            <span data-time>0:00</span><span class="record-limit"> / 0:{MAX_SECONDS}</span>
          </p>
          <p class="record-hint" data-record-hint>Tap the key and hum</p>
        </div>
      </div>
      <div class="take" data-take hidden>
        <audio controls preload="metadata" data-take-player aria-label="Your recording"></audio>
        <a class="icon-button" data-download download="humm-recording.wav" aria-label="Download recording" hidden><Icon name="download" /></a>
        <button type="button" class="icon-button" data-discard aria-label="Delete recording"><Icon name="trash-2" /></button>
      </div>
      <pre class="humm-debug" data-hum-debug hidden></pre>
    </div>

    <div class="humm-form">
      <label class="field">
        <span class="field-label">What do you remember? (optional)</span>
        <textarea data-hint rows="3" maxlength="500" placeholder="e.g. with Pitbull, in Spanish, sounds like “que loquera”"></textarea>
        <span class="field-help">A few words, the singer, the language, where or when you heard it.</span>
      </label>
      <div class="actions">
        <button type="button" class="btn btn-primary" data-find disabled><Icon name="search" /> Find the song</button>
      </div>
      <p class="humm-note">
        <Icon name="info" />
        <span>
          To find the song, your recording and notes are sent to Google’s Gemini AI. We don’t keep them.{' '}
          <a href={privacyUrl}>How your data is handled</a>
        </span>
      </p>
    </div>
  </div>

  <p class="status" data-status role="status" aria-live="polite"></p>

  <section class="humm-results results" data-results aria-label="Results" hidden>
    <div class="progress" data-progress hidden>
      <svg class="progress-ring" viewBox="0 0 48 48" aria-hidden="true">
        <circle class="progress-track" cx="24" cy="24" r="20"></circle>
        <circle class="progress-arc" cx="24" cy="24" r="20" data-arc></circle>
      </svg>
      <div>
        <p class="progress-title" data-progress-title role="status">Finding your song</p>
        <p class="progress-time" data-progress-time></p>
      </div>
    </div>

    <div data-answer hidden>
      <p class="heard" data-heard></p>
      <ul class="guess-list" data-guesses></ul>
      <p class="humm-question" data-question hidden></p>

      <!-- Google requires its search suggestions to be shown next to every answer that used Google Search. -->
      <div class="web-search" data-web hidden>
        <p class="web-label">Humm searched the web for this:</p>
        <iframe
          class="search-suggestions"
          data-suggestions
          title="Google search suggestions"
          sandbox="allow-popups allow-popups-to-escape-sandbox"
          hidden></iframe>
        <p class="sources" data-sources hidden></p>
      </div>

      <form class="follow-up" data-follow-up>
        <label class="field">
          <span class="field-label">None of these? Tell Humm more (optional)</span>
          <input type="text" data-feedback maxlength="300" placeholder="e.g. it’s older, a woman sings, the chorus is faster" />
        </label>
        <button type="submit" class="btn btn-primary"><Icon name="refresh-cw" /> Search again</button>
      </form>
      <p class="answer-model" data-model></p>
    </div>

    <div class="found" data-found hidden>
      <p class="status" data-kind="success" data-found-text></p>
      <div class="actions">
        <button type="button" class="btn btn-secondary" data-restart><Icon name="mic" /> Find another song</button>
      </div>
      <SupportBox />
    </div>
  </section>

  <!-- One result row. The script copies it for each song and fills in the texts. -->
  <template data-guess-template>
    <li class="guess">
      <div class="guess-head">
        <div class="guess-name">
          <strong data-title></strong>
          <span data-artist></span>
        </div>
        <div class="guess-sure">
          <span class="readout" data-confidence></span>
          <span class="guess-sure-label">sure</span>
        </div>
      </div>
      <div class="confidence-meter" aria-hidden="true"><span data-meter></span></div>
      <p class="guess-why" data-why></p>
      <!-- The preview, right in the row: Apple's 30-second preview in this small player of our own –
           its progress line becomes the song's melody once Humm has found it – or Spotify's player
           (added by the script) when Apple doesn't have the song. -->
      <div class="guess-preview" data-preview>
        <div class="mini-player" data-apple-player>
          <button type="button" class="mini-player-key" data-play aria-pressed="false" aria-label="Play preview" disabled>
            <span data-play-icon><Icon name="play" /></span>
            <span data-pause-icon hidden><Icon name="pause" /></span>
          </button>
          <div class="mini-player-body">
            <p class="mini-player-head">
              <span class="mini-player-label" data-preview-label>Looking for a preview …</span>
              <span class="mini-player-time readout"><span data-preview-time>0:00</span><span class="mini-player-length"> / 0:30</span></span>
            </p>
            <span class="mini-player-track" data-preview-track aria-hidden="true"><span data-preview-bar></span></span>
            <canvas class="mini-player-melody" data-song-line aria-hidden="true" hidden></canvas>
          </div>
        </div>
      </div>
      <!-- "Your tune fits this song at 0:12": the melody check (src/lib/compare.ts) -->
      <p class="guess-fit" data-fit hidden></p>
      <div class="guess-actions">
        <button type="button" class="btn btn-secondary btn-small" data-pick><Icon name="check" /> That’s it</button>
        <ul class="chip-list guess-links">
          <li><a data-spotify target="_blank" rel="noopener">Spotify</a></li>
          <li><a data-youtube target="_blank" rel="noopener">YouTube</a></li>
          <li data-apple-item hidden><a data-apple target="_blank" rel="noopener">Apple Music</a></li>
        </ul>
      </div>
      <pre class="guess-debug" data-debug hidden></pre>
    </li>
  </template>
</div>

<script>
  import { load, save } from '@tools/shared/lib/storage';
  import { RELIABLE_STEPS, compareMelodies, evenSteps, fitLabel, type MelodyMatch, type TimedNote } from '../lib/compare';
  import { melodyLine, silences, soundLevel, type MelodyPoint } from '../lib/melody';
  import { detectPitch, frequencyToNote, loudness } from '../lib/pitch';
  import { estimateSeconds, progressFraction, timeLeftText } from '../lib/progress';
  import { SONG_RATE, melodyNotes, songMelody } from '../lib/songmelody';
  import type { Answer, Guess, IdentifyRequest, Preview, Round } from '../lib/types';
  import { appleMusicLink, isSpotifyId, lyricWords, spotifyLink, youtubeLink } from '../lib/songs';
  import { WAV_SAMPLE_RATE } from '../lib/wav';
  import { findApplePreview } from '../scripts/itunes';
  import { MAX_SECONDS, MIN_SECONDS, recordingToWavBase64 } from '../scripts/recording';

  for (const root of document.querySelectorAll<HTMLElement>('[data-humm]')) setupHumm(root);

  function setupHumm(root: HTMLElement): void {
    const find = <T extends Element = HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const staff = find<HTMLCanvasElement>('[data-staff]');
    const legend = find('[data-legend]');
    const recordKey = find<HTMLButtonElement>('[data-record]');
    const timeText = find('[data-time]');
    const recordHint = find('[data-record-hint]');
    const take = find('[data-take]');
    const takePlayer = find<HTMLAudioElement>('[data-take-player]');
    const hintField = find<HTMLTextAreaElement>('[data-hint]');
    const findButton = find<HTMLButtonElement>('[data-find]');
    const status = find('[data-status]');
    const results = find('[data-results]');
    const progress = find('[data-progress]');
    const progressTitle = find('[data-progress-title]');
    const progressTime = find('[data-progress-time]');
    const arc = find<SVGCircleElement>('[data-arc]');
    const answerBox = find('[data-answer]');
    const heard = find('[data-heard]');
    const guessList = find('[data-guesses]');
    const question = find('[data-question]');
    const webBox = find('[data-web]');
    const suggestions = find<HTMLIFrameElement>('[data-suggestions]');
    const sources = find('[data-sources]');
    const followUp = find<HTMLFormElement>('[data-follow-up]');
    const feedbackField = find<HTMLInputElement>('[data-feedback]');
    const modelText = find('[data-model]');
    const found = find('[data-found]');
    const foundText = find('[data-found-text]');
    const template = find<HTMLTemplateElement>('[data-guess-template]');

    // ------------------------------------------------------------------ state

    let audio: string | null = null; // the recording as base64 WAV, once it's ready
    let converting = false; // true while the recording is turned into a WAV
    let busy = false; // true while Humm is searching
    let rounds: Round[] = []; // earlier tries of this search (songs that were wrong + feedback)
    let lastGuesses: Guess[] = [];

    let recorder: MediaRecorder | null = null;
    let starting = false; // true while the browser asks for the microphone
    let recordingNumber = 0; // counts recordings, so a slow old one can't replace a newer one
    let stream: MediaStream | null = null;
    let listener: AudioContext | null = null; // reads the microphone for the melody line
    let startedAt = 0;
    let clock = 0;
    let frame = 0;
    /** The melody so far: seconds since the start, the note (null = no clear note) and the loudness. */
    let melody: MelodyPoint[] = [];

    const previewPlayer = new Audio(); // plays Apple's 30-second previews
    let previewKey: HTMLButtonElement | null = null; // the play key of the preview that is loaded in it
    let startAtLoad = 0; // where to start that preview (where the hummed tune fits), once it has loaded
    let resultsRound = 0; // counts the lists of songs shown, so late work for an old list is dropped
    let micRate = 0; // samples per second of the microphone (shown in debug mode)

    // Debug mode (add ?debug to the address): shows what happens behind the scenes and lets you
    // download your recording – for testing Humm, not for everyday use.
    const debug = new URLSearchParams(location.search).has('debug');

    function updateButtons(): void {
      const recording = recorder?.state === 'recording';
      findButton.disabled = busy || converting || recording || (!audio && hintField.value.trim() === '');
      recordKey.disabled = busy;
      // Only one yellow button at a time: once songs are shown, "Search again" is the main action.
      const hasResults = !results.hidden && !answerBox.hidden;
      findButton.classList.toggle('btn-primary', !hasResults);
      findButton.classList.toggle('btn-secondary', hasResults);
    }
    hintField.addEventListener('input', updateButtons);

    function showStatus(message: string, kind: 'error' | 'info' = 'info'): void {
      status.textContent = message;
      status.dataset.kind = kind;
    }

    // ------------------------------------------------------------------ recording

    recordKey.addEventListener('click', () => {
      if (recorder?.state === 'recording') stopRecording();
      else void startRecording();
    });

    async function startRecording(): Promise<void> {
      if (starting) return;
      showStatus('');
      if (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === 'undefined') {
        showStatus('This browser can’t record sound. Try a recent Chrome, Edge, Firefox or Safari.', 'error');
        return;
      }
      starting = true;
      try {
        // Echo and noise filters are made for speech and would swallow parts of a hummed tune.
        stream = await navigator.mediaDevices.getUserMedia({
          audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: true },
        });
      } catch {
        showStatus('Humm can’t use your microphone. Allow it in your browser’s site settings, then tap the key again.', 'error');
        return;
      } finally {
        starting = false;
      }
      stopPreviews(); // so a playing preview doesn't end up in the recording
      discardRecording(); // a new recording replaces the old one

      const chunks: Blob[] = [];
      const activeRecorder = new MediaRecorder(stream);
      const number = ++recordingNumber;
      recorder = activeRecorder;
      activeRecorder.addEventListener('dataavailable', (event) => chunks.push(event.data));
      activeRecorder.addEventListener('stop', () => {
        void finishRecording(new Blob(chunks, { type: activeRecorder.mimeType || 'audio/webm' }), number);
      });
      activeRecorder.start();
      startedAt = Date.now();
      melody = [];
      try {
        startMelodyLine(stream);
      } catch {
        // No melody line in this browser – the recording itself still works.
      }

      clock = window.setInterval(() => {
        const seconds = (Date.now() - startedAt) / 1000;
        timeText.textContent = formatTime(seconds);
        if (seconds >= MAX_SECONDS) stopRecording();
      }, 200);

      recordKey.setAttribute('aria-pressed', 'true');
      recordKey.setAttribute('aria-label', 'Stop recording');
      find('[data-mic-icon]').hidden = true;
      find('[data-stop-icon]').hidden = false;
      recordHint.textContent = 'Recording – tap to stop';
      updateButtons();
    }

    function stopRecording(): void {
      window.clearInterval(clock);
      cancelAnimationFrame(frame);
      recorder?.stop();
      stream?.getTracks().forEach((track) => track.stop()); // switches the microphone off
      void listener?.close();
      listener = null;
      recordKey.style.removeProperty('--level');
      recordKey.setAttribute('aria-pressed', 'false');
      recordKey.setAttribute('aria-label', 'Start recording');
      find('[data-mic-icon]').hidden = false;
      find('[data-stop-icon]').hidden = true;
      recordHint.textContent = 'Tap the key to record again';
      drawStaff(); // once more, without the "you are here" dot
    }

    async function finishRecording(recording: Blob, number: number): Promise<void> {
      const seconds = (Date.now() - startedAt) / 1000;
      if (seconds < MIN_SECONDS) {
        showStatus('That was very short. Hum for at least a few seconds.', 'error');
        updateButtons();
        return;
      }
      if (takePlayer.src) URL.revokeObjectURL(takePlayer.src);
      takePlayer.src = URL.createObjectURL(recording);
      take.hidden = false;
      converting = true;
      updateButtons();
      let wav: string | null = null;
      try {
        wav = await recordingToWavBase64(recording);
      } catch {
        showStatus('Humm couldn’t read the recording. Please record again.', 'error');
      }
      if (number !== recordingNumber) return; // a newer recording was started meanwhile
      audio = wav;
      converting = false;
      updateButtons();
      if (debug && wav) showRecordingDetails(wav);
    }

    /** Debug mode: a download link for the recording and a few numbers about the melody line. */
    function showRecordingDetails(wav: string): void {
      const bytes = Uint8Array.from(atob(wav), (character) => character.charCodeAt(0));
      const link = find<HTMLAnchorElement>('[data-download]');
      if (link.href.startsWith('blob:')) URL.revokeObjectURL(link.href);
      link.href = URL.createObjectURL(new Blob([bytes], { type: 'audio/wav' }));
      link.hidden = false;
      const clear = melody.filter((point) => point.note !== null).length;
      const details = find('[data-hum-debug]');
      details.textContent = [
        `Recording: ${((bytes.length - 44) / 2 / WAV_SAMPLE_RATE).toFixed(1)} s, sent as a ${WAV_SAMPLE_RATE / 1000} kHz WAV (${bytes.length} bytes)`,
        `Microphone: ${micRate} samples per second`,
        `Measurements: ${melody.length}, with a clear note: ${clear} (${Math.round((100 * clear) / Math.max(1, melody.length))} %)`,
        `Counts as sound from loudness ${soundLevel(melody).toFixed(4)}`,
        `Tune for the melody check: ${evenSteps(melodyLine(melody).flat()).length} steps of 0.1 s`,
      ].join('\n');
      details.hidden = false;
    }

    find('[data-discard]').addEventListener('click', discardRecording);

    function discardRecording(): void {
      audio = null;
      converting = false;
      takePlayer.pause();
      if (takePlayer.src) URL.revokeObjectURL(takePlayer.src);
      takePlayer.removeAttribute('src');
      take.hidden = true;
      find('[data-download]').hidden = true;
      find('[data-hum-debug]').hidden = true;
      melody = [];
      drawStaff();
      timeText.textContent = formatTime(0);
      recordHint.textContent = 'Tap the key and hum';
      updateButtons();
    }

    /** 7.4 → "0:07" */
    function formatTime(seconds: number): string {
      const whole = Math.min(MAX_SECONDS, Math.floor(seconds));
      return `${Math.floor(whole / 60)}:${String(whole % 60).padStart(2, '0')}`;
    }

    // ------------------------------------------------------------------ the melody line

    /**
     * While recording, an AnalyserNode lets us read the newest bit of sound 30 times a second.
     * detectPitch() finds the note in it; drawStaff() draws all notes so far as a line.
     */
    function startMelodyLine(microphone: MediaStream): void {
      listener = new AudioContext();
      void listener.resume(); // some browsers start it paused
      const analyser = listener.createAnalyser();
      analyser.fftSize = 2048;
      listener.createMediaStreamSource(microphone).connect(analyser);
      const wave = new Float32Array(analyser.fftSize);
      const sampleRate = listener.sampleRate;
      micRate = sampleRate;
      let lastCheck = 0;

      const tick = (now: number) => {
        if (recorder?.state !== 'recording') return;
        if (now - lastCheck >= 33) {
          lastCheck = now;
          analyser.getFloatTimeDomainData(wave);
          const hz = detectPitch(wave, sampleRate);
          const level = loudness(wave);
          melody.push({ time: (Date.now() - startedAt) / 1000, note: hz === null ? null : frequencyToNote(hz), level });
          // The key's yellow ring grows with your voice, so you can see the microphone hears you.
          // Measured in decibels (like our ears hear), so soft humming moves it too:
          // a quiet room (−60 dB) = 0, a loud voice close to the phone (−10 dB) = 1.
          const decibels = 20 * Math.log10(level + 1e-9);
          recordKey.style.setProperty('--level', String(Math.min(1, Math.max(0, (decibels + 60) / 50))));
          drawStaff();
        }
        frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
    }

    function drawStaff(): void {
      const context = staff.getContext('2d');
      if (!context) return;
      // Draw sharply on high-resolution screens: more canvas pixels than CSS pixels.
      const ratio = window.devicePixelRatio || 1;
      const width = staff.clientWidth;
      const height = staff.clientHeight;
      if (staff.width !== Math.round(width * ratio) || staff.height !== Math.round(height * ratio)) {
        staff.width = Math.round(width * ratio);
        staff.height = Math.round(height * ratio);
      }
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.clearRect(0, 0, width, height);

      // The colours come from the design (base.css), so light and dark mode both work.
      const style = getComputedStyle(root);
      const color = (name: string) => style.getPropertyValue(name).trim();

      // Five staff lines, like music paper.
      context.strokeStyle = color('--line');
      context.lineWidth = 1;
      for (let i = 0; i < 5; i++) {
        const y = Math.round(height * (0.2 + i * 0.15)) + 0.5;
        context.beginPath();
        context.moveTo(0, y);
        context.lineTo(width, y);
        context.stroke();
      }

      const notes = melody.flatMap((point) => (point.note === null ? [] : [point.note]));
      staff.dataset.notes = String(notes.length); // how many notes were heard (the browser tests check it)
      const line = melodyLine(melody); // the smoothed melody, in pieces (see src/lib/melody.ts)
      const endTime = melody[melody.length - 1]?.time ?? 0; // how long the recording is so far
      const gaps = silences(line, endTime);
      legend.hidden = gaps.length === 0;

      // Fit the melody into the height (at least 14 semitones, so a steady note stays in the middle).
      const smoothNotes = line.flat().map((point) => point.note);
      const lowest = smoothNotes.length > 0 ? Math.min(...smoothNotes) : 60;
      const highest = smoothNotes.length > 0 ? Math.max(...smoothNotes) : 60;
      const span = Math.max(14, highest - lowest + 4);
      const bottom = (lowest + highest) / 2 - span / 2;
      // The staff shows at least 8 seconds and grows with the recording, so a short hum isn't squeezed.
      const shownSeconds = Math.max(8, endTime);
      const x = (time: number) => 10 + (time / shownSeconds) * (width - 20);
      const y = (note: number | null) => (note === null ? height / 2 : height * 0.9 - ((note - bottom) / span) * height * 0.8);

      // Silence: a red dashed line, so a gap in the melody clearly means "nothing heard here".
      context.strokeStyle = color('--stop');
      context.lineWidth = 2;
      context.setLineDash([4, 5]);
      for (const gap of gaps) {
        context.beginPath();
        context.moveTo(x(gap.start), y(gap.fromNote));
        context.lineTo(x(gap.end), y(gap.toNote));
        context.stroke();
      }
      context.setLineDash([]);

      if (line.length === 0) {
        context.fillStyle = color('--pencil');
        context.font = `500 15px ${style.fontFamily}`;
        context.textAlign = 'center';
        context.textBaseline = 'middle';
        const empty = recorder?.state === 'recording' ? 'Listening …' : endTime > 0 ? 'No tune heard' : 'Your melody appears here';
        // Above the red line if there is one, otherwise in the middle
        context.fillText(empty, width / 2, gaps.length > 0 ? height / 2 - 18 : height / 2);
        return;
      }

      context.strokeStyle = color('--ink');
      context.lineWidth = 3;
      context.lineCap = 'round';
      context.lineJoin = 'round';
      for (const segment of line) {
        // A smooth curve through the points: each point pulls the line towards itself
        // ("quadratic curve" to the middle between it and the next point), so there are no corners.
        context.beginPath();
        context.moveTo(x(segment[0]!.time), y(segment[0]!.note));
        for (let i = 1; i < segment.length - 1; i++) {
          const point = segment[i]!;
          const next = segment[i + 1]!;
          context.quadraticCurveTo(x(point.time), y(point.note), (x(point.time) + x(next.time)) / 2, (y(point.note) + y(next.note)) / 2);
        }
        const end = segment[segment.length - 1]!;
        context.lineTo(x(end.time), y(end.note));
        context.stroke();
      }

      // The note you are humming right now: a yellow dot with an ink rim at the end of the line
      // (only while the line reaches up to now, i.e. while you sing).
      const lastPoint = line[line.length - 1]![line[line.length - 1]!.length - 1]!;
      if (recorder?.state === 'recording' && endTime - lastPoint.time < 0.1) {
        context.beginPath();
        context.arc(x(lastPoint.time), y(lastPoint.note), 6, 0, 2 * Math.PI);
        context.fillStyle = color('--marker');
        context.fill();
        context.lineWidth = 2;
        context.stroke();
      }
    }
    drawStaff();
    window.addEventListener('resize', () => {
      drawStaff();
      for (const row of guessList.children) {
        drawSongLine(row as HTMLElement, previewKey && row.contains(previewKey) ? previewPlayer.currentTime : 0);
      }
    });

    // ------------------------------------------------------------------ searching

    findButton.addEventListener('click', () => {
      rounds = []; // a new search
      lastGuesses = [];
      void search();
    });

    followUp.addEventListener('submit', (event) => {
      event.preventDefault();
      if (busy) return;
      rounds.push({
        guesses: lastGuesses.map(({ title, artist }) => ({ title, artist })),
        feedback: feedbackField.value.trim() || 'None of these are right.',
      });
      void search();
    });

    async function search(): Promise<void> {
      const hint = hintField.value.trim();
      if (!audio && !hint) return;
      const webSearch = rounds.length > 0; // from the second try on, Humm also searches the web
      // The hummed tune, one note every 0.1 s, to compare with the songs' melodies later.
      const tune = audio ? evenSteps(melodyLine(melody).flat()) : [];
      busy = true;
      updateButtons();
      stopPreviews();
      showStatus('');
      results.hidden = false;
      answerBox.hidden = true;
      found.hidden = true;
      startProgress(webSearch);

      try {
        const request: IdentifyRequest = { audio: audio ?? undefined, hint, rounds };
        let answer = await askHumm(request, webSearch);
        // Words were heard, but Humm isn't sure yet: check them on the web right away.
        if (!webSearch && shouldCheckOnTheWeb(answer, request)) {
          startProgress(true, answer.words ? `Checking “${answer.words}” on the web` : 'Checking on the web');
          const check = { words: answer.words, guesses: answer.guesses.map(({ title, artist }) => ({ title, artist })) };
          const quick = answer;
          answer = await askHumm({ ...request, check }, true).catch(() => quick); // if that fails, the quick answer stays
        }
        feedbackField.value = '';
        showAnswer(answer, tune);
      } catch (error) {
        rounds.pop(); // this try didn't happen – the visitor can send the same feedback again
        const name = error instanceof Error ? error.name : '';
        const message =
          name === 'TimeoutError'
            ? 'Humm took too long to answer. Please try again.'
            : name === 'TypeError'
              ? 'Humm couldn’t be reached. Check your internet connection and try again.'
              : error instanceof Error
                ? error.message
                : 'Something went wrong. Please try again.';
        showStatus(message, 'error');
        // After a failed "Search again", the earlier songs stay on screen.
        answerBox.hidden = lastGuesses.length === 0;
        results.hidden = answerBox.hidden;
      } finally {
        stopProgress();
        busy = false;
        updateButtons();
      }
    }

    /** One question to our Worker (src/worker/). Remembers how long it took, for the waiting circle. */
    async function askHumm(request: IdentifyRequest, webSearch: boolean): Promise<Answer> {
      const started = performance.now();
      const response = await fetch('/api/identify', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(request),
        signal: AbortSignal.timeout(100_000), // never wait longer than 100 seconds
      });
      const data = (await response.json().catch(() => ({}))) as Partial<Answer> & { error?: string };
      if (!response.ok) throw new Error(data.error || `Something went wrong (error ${response.status}). Please try again.`);
      rememberDuration(webSearch, (performance.now() - started) / 1000);
      return { ...data, guesses: data.guesses ?? [], words: data.words ?? '' } as Answer;
    }

    /**
     * The words are the best clue there is. So when the recording had words (or the visitor typed
     * a few words without recording) and Humm isn't sure yet, the quick answer is checked on the web.
     * "na na na" doesn't count as words (see lyricWords).
     */
    function shouldCheckOnTheWeb(answer: Answer, request: IdentifyRequest): boolean {
      const best = Math.max(0, ...answer.guesses.map((guess) => guess.confidence));
      const typedOnly = !request.audio && lyricWords(request.hint ?? '') >= 3;
      return (lyricWords(answer.words) >= 2 || typedOnly) && best < 70;
    }

    // ------------------------------------------------------------------ the waiting circle

    const circumference = 2 * Math.PI * 20; // the circle's radius is 20 (see the <svg> above)
    let progressClock = 0;
    const durationKey = (webSearch: boolean) => `humm:durations:${webSearch ? 'web' : 'quick'}`;

    function startProgress(webSearch: boolean, title?: string): void {
      window.clearInterval(progressClock); // a second step starts its own circle
      // First visit: a quick try takes about 12 s, a try with web search about 25 s.
      const estimate = estimateSeconds(load<number[]>(durationKey(webSearch), []), webSearch ? 25 : 12);
      progressTitle.textContent = title ?? (webSearch ? 'Searching again, on the web too' : 'Finding your song');
      progress.hidden = false;
      const started = performance.now();
      const update = () => {
        const elapsed = (performance.now() - started) / 1000;
        arc.style.strokeDashoffset = String(circumference * (1 - progressFraction(elapsed, estimate)));
        progressTime.textContent = timeLeftText(elapsed, estimate);
      };
      update();
      progressClock = window.setInterval(update, 250);
      progress.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }

    function stopProgress(): void {
      window.clearInterval(progressClock);
      progress.hidden = true;
    }

    function rememberDuration(webSearch: boolean, seconds: number): void {
      const key = durationKey(webSearch);
      save(key, [...load<number[]>(key, []), Math.round(seconds)].slice(-5));
    }

    // ------------------------------------------------------------------ showing the answer

    function showAnswer(answer: Answer, tune: TimedNote[]): void {
      lastGuesses = answer.guesses ?? [];
      heard.textContent = [
        answer.heard ? `Humm heard: ${answer.heard}` : '',
        answer.words ? `Words: “${answer.words}”` : '',
        lastGuesses.length === 0 ? 'No song matched. Tell Humm more below and search again.' : '',
      ]
        .filter(Boolean)
        .join(' ');
      previewKey = null; // the earlier songs and their previews are replaced
      resultsRound++;
      guessList.replaceChildren(...lastGuesses.map((guess) => renderGuess(guess, tune)));
      question.textContent = answer.question ?? '';
      question.hidden = !answer.question;

      // Google's search suggestions: ready-made HTML from Google, shown in a locked-down frame
      // (no scripts; links open in a new tab).
      webBox.hidden = !answer.searchSuggestions && !answer.sources?.length;
      suggestions.hidden = !answer.searchSuggestions;
      suggestions.srcdoc = answer.searchSuggestions ? `<!doctype html><base target="_blank">${answer.searchSuggestions}` : '';
      sources.replaceChildren();
      const links = (answer.sources ?? []).filter((source) => source.url.startsWith('https://'));
      if (links.length > 0) {
        sources.append('Sources: ');
        links.forEach((source, i) => {
          const link = document.createElement('a');
          link.href = source.url;
          link.target = '_blank';
          link.rel = 'noopener';
          link.textContent = source.title;
          sources.append(...(i > 0 ? [', ', link] : [link]));
        });
      }
      sources.hidden = links.length === 0;

      modelText.textContent = answer.model ? `Answered by ${answer.model}` : '';
      followUp.hidden = false;
      answerBox.hidden = false;
      updateButtons();
      results.scrollIntoView({ block: 'start', behavior: 'smooth' });
    }

    /** Copies the row template and fills in one song. Texts go in with textContent, never as HTML. */
    function renderGuess(guess: Guess, tune: TimedNote[]): HTMLLIElement {
      const row = template.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
      const part = <T extends Element = HTMLElement>(selector: string) => row.querySelector<T>(selector)!;
      const confidence = Math.max(0, Math.min(100, Math.round(guess.confidence)));

      part('[data-title]').textContent = guess.title;
      part('[data-artist]').textContent = guess.year ? `${guess.artist}, ${guess.year}` : guess.artist;
      part('[data-confidence]').textContent = `${confidence} %`;
      part('[data-meter]').style.width = `${confidence}%`;
      part('[data-why]').textContent = guess.why;

      // Links: straight to the song when Wikidata knew its IDs, otherwise a search on that service.
      const spotify = spotifyLink(guess.ids, guess.title, guess.artist);
      const youtube = youtubeLink(guess.ids, guess.title, guess.artist);
      const spotifyAnchor = part<HTMLAnchorElement>('[data-spotify]');
      const youtubeAnchor = part<HTMLAnchorElement>('[data-youtube]');
      spotifyAnchor.href = spotify.href;
      spotifyAnchor.textContent = spotify.direct ? 'Spotify' : 'Search on Spotify';
      youtubeAnchor.href = youtube.href;
      youtubeAnchor.textContent = youtube.direct ? 'YouTube' : 'Search on YouTube';
      const apple = appleMusicLink(guess.ids);
      if (apple) {
        part<HTMLAnchorElement>('[data-apple]').href = apple;
        part('[data-apple-item]').hidden = false;
      }

      void showPreview(row, guess, tune, resultsRound);
      part('[data-pick]').addEventListener('click', () => markFound(row, guess));
      return row;
    }

    // ------------------------------------------------------------------ previews

    /**
     * The song's preview, right in its row: Apple's 30-second preview in our own small player (found
     * by its Apple Music ID or by title and artist, see src/scripts/itunes.ts). If Apple doesn't have
     * the song: Spotify's player, when Wikidata knew the Spotify ID. Otherwise there is no preview,
     * and the links below search for the song.
     */
    async function showPreview(row: HTMLElement, guess: Guess, tune: TimedNote[], round: number): Promise<void> {
      const box = row.querySelector<HTMLElement>('[data-preview]')!;
      const preview = await findApplePreview({ title: guess.title, artist: guess.artist, appleId: guess.ids?.apple });
      if (round !== resultsRound) return; // other songs are shown by now
      note(row, preview ? `Apple (${preview.via}): “${preview.title}” by ${preview.artist}` : 'Apple: no preview found');
      if (preview) {
        readyApplePlayer(row, preview, guess.title);
        // The melody check takes a moment per song, so the songs take turns, the first one first.
        if (tune.length > 0) {
          melodyChecks = melodyChecks
            .then(() => checkMelody(row, preview, tune, round))
            .catch((error: unknown) => note(row, `Melody check failed: ${String(error)}`));
        }
        else note(row, 'Melody check: no recorded tune');
      } else if (isSpotifyId(guess.ids?.spotify)) {
        embedSpotify(box, guess.ids.spotify, guess.title);
      } else {
        box.hidden = true;
      }
    }

    /** Spotify's own player (theme=0: its dark look, not coloured like the album cover). Only checked IDs get here. */
    function embedSpotify(box: HTMLElement, id: string, title: string): void {
      const frame = document.createElement('iframe');
      frame.src = `https://open.spotify.com/embed/track/${id}?theme=0`;
      frame.title = `${title} on Spotify`;
      frame.className = 'spotify-player';
      frame.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
      frame.loading = 'lazy'; // players further down load only when you scroll to them
      box.replaceChildren(frame);
    }

    /** Our own player is ready: the key plays the preview (from where the tune fits, once that is known). */
    function readyApplePlayer(row: HTMLElement, preview: Preview, title: string): void {
      const key = row.querySelector<HTMLButtonElement>('[data-play]')!;
      key.disabled = false;
      key.setAttribute('aria-label', `Play preview of ${title}`); // screen readers can tell the songs apart
      row.querySelector('[data-preview-label]')!.textContent = 'Preview from Apple Music';
      key.addEventListener('click', () => togglePreview(key, preview.audioUrl, rowMelodies.get(row)?.startAt ?? 0));
      // Tapping the song's melody line plays from that point.
      const line = row.querySelector<HTMLCanvasElement>('[data-song-line]')!;
      line.addEventListener('click', (event) => {
        const song = rowMelodies.get(row)?.song;
        if (!song) return;
        const seconds = (event.offsetX / line.clientWidth) * song.seconds;
        if (previewKey === key) {
          previewPlayer.currentTime = seconds;
          if (previewPlayer.paused) togglePreview(key, preview.audioUrl, seconds);
        } else togglePreview(key, preview.audioUrl, seconds);
      });
    }

    /** Plays or pauses an Apple preview. Tapping the same one again continues where it stopped. */
    function togglePreview(key: HTMLButtonElement, url: string, startAt: number): void {
      if (previewKey === key && !previewPlayer.paused) {
        previewPlayer.pause();
        return;
      }
      takePlayer.pause();
      if (previewKey !== key) {
        if (previewKey) showProgress(previewKey, 0); // the other preview starts from the beginning next time
        previewKey = key;
        previewPlayer.src = url;
        startAtLoad = startAt; // where the hummed tune fits – set as soon as the browser knows the file
      }
      previewPlayer.play().catch((error: unknown) => {
        // "AbortError": the visitor paused or picked another preview before this one began – no problem.
        if (error instanceof DOMException && error.name === 'AbortError') return;
        showStatus('This preview can’t be played right now. Try the links next to it.', 'error');
      });
    }

    // The play keys follow the player: a pause sign on the one that is playing, play signs on the others.
    function setPlaying(playing: boolean): void {
      for (const key of guessList.querySelectorAll<HTMLButtonElement>('[data-play]')) {
        const isPlaying = playing && key === previewKey;
        key.setAttribute('aria-pressed', String(isPlaying));
        key.querySelector<HTMLElement>('[data-play-icon]')!.hidden = isPlaying;
        key.querySelector<HTMLElement>('[data-pause-icon]')!.hidden = !isPlaying;
      }
    }
    // The time can only be set once the browser has read the start of the file ("metadata").
    previewPlayer.addEventListener('loadedmetadata', () => {
      if (startAtLoad > 0) previewPlayer.currentTime = startAtLoad;
      startAtLoad = 0;
    });
    previewPlayer.addEventListener('play', () => setPlaying(true));
    previewPlayer.addEventListener('pause', () => setPlaying(false));
    previewPlayer.addEventListener('timeupdate', () => {
      if (previewKey) showProgress(previewKey, previewPlayer.currentTime);
    });
    previewPlayer.addEventListener('ended', () => {
      if (previewKey) showProgress(previewKey, 0);
    });

    /** Moves the progress line (or the line on the song's melody) and the time of a player to `seconds`. */
    function showProgress(key: HTMLButtonElement, seconds: number): void {
      const row = key.closest<HTMLElement>('.guess');
      if (!row) return;
      const length = Number.isFinite(previewPlayer.duration) ? previewPlayer.duration : 30;
      row.querySelector<HTMLElement>('[data-preview-bar]')!.style.width = `${Math.min(100, (seconds / length) * 100)}%`;
      row.querySelector('[data-preview-time]')!.textContent = formatTime(seconds);
      drawSongLine(row, seconds);
    }

    /**
     * Stops every preview. Our own player can simply be paused. Spotify's player lives on Spotify's
     * website and can't be paused from here – but loading it again stops it.
     */
    function stopPreviews(rows: Element[] = [...guessList.children]): void {
      for (const row of rows) {
        if (previewKey && row.contains(previewKey)) previewPlayer.pause();
        for (const frame of row.querySelectorAll('iframe')) frame.src = frame.src;
      }
    }

    // ------------------------------------------------------------------ the melody check

    /** A song's melody (one note every 0.1 s) and the length of its preview. */
    interface SongTune {
      notes: TimedNote[];
      seconds: number;
    }

    /** What the melody check found for a row: drawn in its player and used to start the preview. */
    const rowMelodies = new WeakMap<Element, { song: SongTune; tune: TimedNote[]; match: MelodyMatch | null; startAt: number }>();
    const songTunes = new Map<string, Promise<SongTune>>(); // each preview is downloaded and analysed only once
    let melodyChecks = Promise.resolve();

    /**
     * Finds the melody in the song's preview (src/lib/songmelody.ts) and compares it with the
     * visitor's tune (src/lib/compare.ts). The player's progress line becomes the song's melody,
     * with the tune drawn on top where it fits – and the preview starts there.
     */
    async function checkMelody(row: HTMLElement, preview: Preview, tune: TimedNote[], round: number): Promise<void> {
      if (round !== resultsRound || !row.isConnected) return;
      let song: SongTune;
      try {
        if (!songTunes.has(preview.audioUrl)) songTunes.set(preview.audioUrl, readSong(preview.audioUrl));
        song = await songTunes.get(preview.audioUrl)!;
      } catch (error) {
        note(row, `Melody check: ${error instanceof Error ? error.message : 'failed'}`);
        return;
      }
      if (round !== resultsRound) return;

      const match = compareMelodies(tune, song.notes);
      const label = match ? fitLabel(match, tune.length) : null;
      note(
        row,
        match
          ? `Melody check: fit ${match.fit.toFixed(3)} → ${label ?? 'no claim'} (tune ${tune.length} steps, reliable from ${RELIABLE_STEPS}), song ${match.start.toFixed(1)}–${match.end.toFixed(1)} s, ${match.shift} semitones higher`
          : `Melody check: too little melody to compare (tune ${tune.length}, song ${song.notes.length} steps)`,
      );
      const fits = match !== null && label !== null;
      const startAt = fits ? Math.max(0, match.start - 0.5) : 0; // half a second before, to hear it coming
      rowMelodies.set(row, { song, tune, match: fits ? match : null, startAt });

      // The thin progress line becomes the song's melody.
      row.querySelector<HTMLElement>('[data-preview-track]')!.hidden = true;
      row.querySelector<HTMLElement>('[data-song-line]')!.hidden = false;
      drawSongLine(row, 0);
      if (!fits) return;
      const fit = row.querySelector<HTMLElement>('[data-fit]')!;
      fit.textContent =
        label === 'good'
          ? `Your tune fits this song well at ${formatTime(match.start)}. The preview starts there.`
          : `Parts of your tune fit this song at ${formatTime(match.start)}. The preview starts there.`;
      fit.hidden = false;
      row.querySelector('[data-preview-time]')!.textContent = formatTime(startAt);
    }

    /**
     * Downloads a preview and finds its melody. This only works if Apple allows web pages to read
     * the file ("CORS") – if not, there is simply no melody check, and the preview still plays.
     */
    async function readSong(url: string): Promise<SongTune> {
      const response = await fetch(url);
      if (!response.ok) throw new Error(`the preview could not be downloaded (error ${response.status})`);
      // Decoded at 16,000 samples per second (works in every browser) …
      const decoded = await new OfflineAudioContext(1, 1, WAV_SAMPLE_RATE).decodeAudioData(await response.arrayBuffer());
      // … mixed to mono, with every two samples averaged into one: 8,000 per second.
      const channels = Array.from({ length: decoded.numberOfChannels }, (_, c) => decoded.getChannelData(c));
      const samples = new Float32Array(Math.floor(decoded.length / 2));
      for (let i = 0; i < samples.length; i++) {
        let sum = 0;
        for (const channel of channels) sum += channel[2 * i]! + channel[2 * i + 1]!;
        samples[i] = sum / (2 * channels.length);
      }
      await new Promise((resolve) => setTimeout(resolve, 0)); // let the page react between the heavy steps
      return { notes: evenSteps(melodyNotes(songMelody(samples, SONG_RATE))), seconds: decoded.duration };
    }

    /**
     * Draws the song's melody (grey), the visitor's tune where it fits (ink, moved into the song's
     * key and stretched to the song's speed) and how far the preview has played.
     */
    function drawSongLine(row: HTMLElement, seconds: number): void {
      const data = rowMelodies.get(row);
      const canvas = row.querySelector<HTMLCanvasElement>('[data-song-line]');
      const context = canvas?.getContext('2d');
      if (!data || !canvas || !context || canvas.clientWidth === 0) return;
      const ratio = window.devicePixelRatio || 1;
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      if (canvas.width !== Math.round(width * ratio) || canvas.height !== Math.round(height * ratio)) {
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
      }
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      context.clearRect(0, 0, width, height);
      const style = getComputedStyle(root);
      const color = (name: string) => style.getPropertyValue(name).trim();

      // Fit the song's usual notes into the height (a few very high or low ones may stick out).
      const sorted = data.song.notes.map((step) => step.note).sort((a, b) => a - b);
      const low = sorted[Math.floor(sorted.length * 0.05)] ?? 60;
      const high = sorted[Math.floor(sorted.length * 0.95)] ?? 72;
      const span = Math.max(12, high - low + 2);
      const bottom = (low + high) / 2 - span / 2;
      const x = (time: number) => (time / data.song.seconds) * width;
      const y = (note: number) => Math.max(1, Math.min(height - 1, height - 2 - ((note - bottom) / span) * (height - 4)));
      context.lineCap = 'round';
      context.lineJoin = 'round';

      // The song's melody: a line from step to step; a gap of more than 0.25 s stays a gap.
      context.strokeStyle = color('--edge');
      context.lineWidth = 2;
      context.beginPath();
      data.song.notes.forEach((step, i) => {
        const previous = data.song.notes[i - 1];
        if (previous && step.time - previous.time < 0.25) context.lineTo(x(step.time), y(step.note));
        else context.moveTo(x(step.time), y(step.note));
      });
      context.stroke();

      // The visitor's tune where it fits, in the octave the song sings in.
      if (data.match) {
        const hummed = new Map(data.tune.map((step) => [step.time, step.note]));
        const sung = new Map(data.song.notes.map((step) => [step.time, step.note]));
        context.strokeStyle = color('--ink');
        context.lineWidth = 2.5;
        context.beginPath();
        data.match.pairs.forEach(([humTime, songTime], i) => {
          const note = hummed.get(humTime)! + data.match!.shift;
          const target = sung.get(songTime)!;
          const point = [x(songTime), y(note + 12 * Math.round((target - note) / 12))] as const;
          if (i === 0) context.moveTo(...point);
          else context.lineTo(...point);
        });
        context.stroke();
      }

      // How far the preview has played: a thin ink line.
      if (seconds > 0) {
        context.fillStyle = color('--ink');
        context.fillRect(Math.round(x(seconds)) - 1, 0, 2, height);
      }
    }

    /** Debug mode only (?debug in the address): what happened behind the scenes, as plain text. */
    function note(row: HTMLElement, text: string): void {
      if (!debug) return;
      const box = row.querySelector<HTMLElement>('[data-debug]')!;
      box.textContent += `${text}\n`;
      box.hidden = false;
    }

    // ------------------------------------------------------------------ "That's it"

    function markFound(row: HTMLLIElement, guess: Guess): void {
      for (const other of guessList.children) (other as HTMLElement).hidden = other !== row;
      stopPreviews([...guessList.children].filter((other) => other !== row)); // the hidden songs go quiet
      row.classList.add('is-found');
      row.querySelector<HTMLElement>('[data-pick]')!.hidden = true;
      question.hidden = true;
      followUp.hidden = true;
      foundText.textContent = `Found it: “${guess.title}” by ${guess.artist}.`;
      found.hidden = false;
      found.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }

    find('[data-restart]').addEventListener('click', () => {
      previewPlayer.pause();
      guessList.replaceChildren(); // removing the songs removes (and stops) their players too
      previewKey = null;
      resultsRound++; // melody checks that are still waiting are dropped
      rounds = [];
      lastGuesses = [];
      hintField.value = '';
      discardRecording();
      results.hidden = true;
      updateButtons();
      showStatus('');
      root.scrollIntoView({ block: 'start', behavior: 'smooth' });
      recordKey.focus({ preventScroll: true });
    });
  }
</script>
