---
/**
 * Front page of the central domain. The tin picture shows one tool per site; below it, each
 * site gets a column (lined up under its tool) with its most popular pages.
 */
import Icon from '@tools/shared/components/Icon.astro';
import SiteLayout from '@tools/shared/components/SiteLayout.astro';
import { websiteSchema } from '@tools/shared/lib/seo';
import { features, network, sites, siteUrl } from '@tools/shared/network';
import TinScene from '../components/TinScene.astro';
import '../styles/hub.css';

const title = `${network.name} – Free Online Tools for PDF, Typing and More`;
const description =
  'Free online tools that work right in your browser: PDF and image tools, a typing speed test, a random name picker wheel and more. No sign-up, no uploads.';
const toolSites = sites.filter((site) => site.id !== 'hub');
---

<SiteLayout site="hub" title={title} description={description} path="/" jsonLd={[websiteSchema(network.name, `${siteUrl('hub')}/`, description)]}>
  <div class="container">
    <section class="hub-hero">
      <h1 class="display">A tin of handy tools for everyday jobs.</h1>
      <p class="lead">
        Merge a PDF, pick a random name for class or check how fast you type. Everything runs in your browser, so your
        files and texts never leave your computer.
      </p>
    </section>

    <TinScene />

    <ul class="site-list">
      {
        toolSites.map((site) => (
          <li>
            <h2>
              <a href={`${siteUrl(site.id)}/`}>{site.name}</a>
            </h2>
            <p>{site.description}</p>
            <ul>
              {site.links.map((link) => (
                <li>
                  <a href={siteUrl(site.id) + link.path}>{link.label}</a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <section class="hub-about">
      <div>
        <h2>How can it be free?</h2>
        <p>
          Your own browser does the work, so the sites need no servers and cost almost nothing to run.
          {features.ads && ' A few ads pay for the rest.'} You never need an account, and there is no paid version.
        </p>
      </div>
      <div class="callout">
        <Icon name="eye" />
        <div>
          <h2>Check it yourself</h2>
          <p>
            Open your browser’s developer tools (F12 on most computers), switch to the Network tab and use any tool.
            You’ll see that your files are never sent anywhere.
          </p>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
