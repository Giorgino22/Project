---
/**
 * The typing test. Words appear in the box; the visitor types them into the field below and
 * presses the space bar after each word. The timer starts with the first key.
 * Behaviour: <script> below. Scoring (WPM, Anschläge, accuracy) lives in src/lib/typing.ts.
 * The words come from the page's language (English: src/lib/words.ts, German: words-de.ts).
 */
import Icon from '@tools/shared/components/Icon.astro';
import SupportBox from '@tools/shared/components/SupportBox.astro';
import { t, type SiteLang } from '../i18n';
import { durationLabel, LESSON_IDS, type TestOptions } from '../lib/typing';

type Props = TestOptions & { lang: SiteLang };

const { lang, duration, durations = [], words = 'common', lessons = false, large = false } = Astro.props;
const dict = t(lang);
const text = dict.test;
// 'cpm': the big number shows Anschläge per minute, with words per minute in a smaller line below it.
const showCpm = text.measure === 'cpm';
---

{/* data-i18n: the texts travel along as JSON, so the script can show its messages in the page's language */}
<div
  class:list={['typing card', { 'typing-large': large }]}
  data-typing
  data-lang={lang}
  data-i18n={JSON.stringify({ ...text, ratings: dict.ratings })}
  data-duration={duration}
  data-words={words}
>
  <div class="typing-bar">
    {
      durations.length > 0 && (
        <div class="segmented" role="radiogroup" aria-label={text.length}>
          {durations.map((seconds) => (
            <label>
              <input type="radio" name="duration" value={seconds} checked={seconds === duration} />
              <span>{durationLabel(seconds, text)}</span>
            </label>
          ))}
        </div>
      )
    }
    {
      lessons && (
        <label class="typing-lesson">
          <span>{text.lesson}</span>
          <select data-lesson>
            {LESSON_IDS.map((id) => (
              <option value={id}>{dict.lessons[id]}</option>
            ))}
          </select>
        </label>
      )
    }
    <span class="typing-timer" data-timer role="timer" aria-label={text.time}></span>
  </div>

  <div data-area>
    <div class="typing-words" data-box></div>
    <div class="typing-entry">
      <input
        type="text"
        data-input
        aria-label={text.inputLabel}
        placeholder={text.placeholder}
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        enterkeyhint="next"
      />
      <button type="button" class="btn btn-secondary" data-restart title={text.restartTitle}><Icon name="rotate-ccw" /> <span>{text.restart}</span></button>
    </div>
    <p class="typing-best" data-best></p>
  </div>

  <section class="typing-result" data-result hidden tabindex="-1" aria-label={text.result}>
    <p class="result-speed"><strong data-speed></strong> <span>{showCpm ? text.cpm : text.wpm}</span></p>
    {showCpm && <p class="result-speed-second"><strong data-wpm></strong> {text.wpm}</p>}
    <p class="result-rating" data-rating></p>
    <dl class="result-stats">
      <div><dt>{text.accuracy}</dt><dd data-accuracy></dd></div>
      <div><dt>{text.correct}</dt><dd data-correct></dd></div>
      <div><dt>{text.wrong}</dt><dd data-wrong></dd></div>
      <div><dt>{text.best}</dt><dd data-best-value></dd></div>
    </dl>
    <p class="result-mistakes" data-mistakes hidden></p>
    <div class="actions">
      <button type="button" class="btn btn-primary" data-again><Icon name="rotate-ccw" /> {text.again}</button>
      <button type="button" class="btn btn-secondary" data-share><Icon name="share-2" /> {text.share}</button>
    </div>
    <p class="status" data-status role="status" aria-live="polite"></p>
    <SupportBox lang={lang} />
  </section>
</div>

<script>
  import { fill } from '@tools/shared/i18n';
  import { load, save } from '@tools/shared/lib/storage';
  import type { Dictionary } from '../i18n/en';
  import {
    countKeystrokes,
    formatTime,
    lessonWords,
    pickWords,
    ratingLevel,
    scoreTest,
    wordSets,
    type LessonId,
    type TestResult,
    type WordLang,
  } from '../lib/typing';

  type Texts = Dictionary['test'] & { ratings: string[] };

  for (const root of document.querySelectorAll<HTMLElement>('[data-typing]')) {
    const find = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const box = find('[data-box]');
    const input = find<HTMLInputElement>('[data-input]');
    const timer = find('[data-timer]');
    const status = find('[data-status]');
    const lesson = root.querySelector<HTMLSelectElement>('[data-lesson]'); // only on the practice page
    const text = JSON.parse(root.dataset.i18n!) as Texts; // the texts in the page's language
    const lang = root.dataset.lang as WordLang;
    const wordSet = wordSets[lang]; // the word lists of the page's language
    // English pages measure speed in words per minute, German ones in Anschläge (characters) per minute.
    const speedOf = (score: TestResult) => (text.measure === 'cpm' ? score.cpm : score.wpm);

    let duration = Number(root.dataset.duration); // seconds; 0 = practice without time limit
    let words: string[] = []; // the words to type
    let spans: HTMLElement[] = []; // one <span> per word in the box
    let typed: string[] = []; // what the visitor typed for each finished word
    let keys = { correct: 0, wrong: 0 }; // keystrokes, for the accuracy
    let previous = ''; // the input field's text at the last check
    let startedAt = 0; // time of the first key (0 = not started yet)
    let ticker = 0; // ID of the clock interval
    let finished = false;
    let lastScore: TestResult | null = null;

    /**
     * Which personal best this test counts towards, e.g. "typing:best:common:60". Other languages
     * keep their own ("typing:best:de:common:60"): other words, and German bests are in Anschläge.
     */
    const bestKey = () =>
      `typing:best:${lang === 'en' ? '' : `${lang}:`}${lesson ? `practice:${lesson.value}` : `${root.dataset.words}:${duration}`}`;
    const isDesktop = () => matchMedia('(pointer: fine)').matches;

    function newWords(): string[] {
      if (lesson) return lessonWords(lesson.value as LessonId, 30, undefined, wordSet);
      // More words than even a record-breaking typist (200 words per minute) can type in time.
      const count = Math.ceil(duration / 60) * 200 + 20;
      return pickWords(root.dataset.words === 'kids' ? wordSet.kids : wordSet.common, count);
    }

    /** Starts a fresh test (the clock waits for the first key). */
    function reset(): void {
      clearInterval(ticker);
      words = newWords();
      typed = [];
      keys = { correct: 0, wrong: 0 };
      previous = '';
      startedAt = 0;
      finished = false;
      spans = words.map((word) => {
        const span = document.createElement('span');
        span.textContent = word;
        return span;
      });
      spans[0]!.classList.add('current');
      box.replaceChildren(...spans);
      box.scrollTop = 0;
      input.value = '';
      input.disabled = false;
      timer.textContent = formatTime(duration);
      const best = load<number>(bestKey(), 0);
      find('[data-best]').textContent = best > 0 ? fill(text.bestSoFar, { best: fill(text.bestValue, { n: best }) }) : '';
      find('[data-area]').hidden = false;
      find('[data-result]').hidden = true;
    }

    const secondsSinceStart = () => (performance.now() - startedAt) / 1000;

    /** Runs 10 times a second while the test is running: updates the clock. */
    function tick(): void {
      if (duration === 0) {
        timer.textContent = formatTime(Math.floor(secondsSinceStart())); // practice: time counts up
        return;
      }
      const left = duration - secondsSinceStart();
      timer.textContent = formatTime(Math.ceil(Math.max(0, left)));
      if (left <= 0) finish();
    }

    /** Adds the letters typed since the last check to the keystroke count. */
    function countKeys(text: string): void {
      const added = countKeystrokes(words[typed.length]!, previous, text);
      keys.correct += added.correct;
      keys.wrong += added.wrong;
      previous = text;
    }

    /** The visitor finished a word (space bar): colour it and move on to the next one. */
    function submit(word: string): void {
      const span = spans[typed.length]!;
      span.classList.remove('current', 'typo');
      span.classList.add(word === words[typed.length] ? 'right' : 'wrong');
      typed.push(word);
      previous = '';
      if (typed.length === words.length) return finish(); // practice: that was the last word

      const next = spans[typed.length]!;
      next.classList.add('current');
      // Keep the line with the current word at the top of the box.
      box.scrollTop = next.offsetTop - spans[0]!.offsetTop;
    }

    function finish(): void {
      finished = true;
      clearInterval(ticker);
      input.disabled = true;

      const score = scoreTest(words, typed, keys, duration || secondsSinceStart());
      const speed = speedOf(score);
      const best = load<number>(bestKey(), 0);
      if (speed > best) save(bestKey(), speed);
      lastScore = score;

      find('[data-speed]').textContent = String(speed);
      const wpm = root.querySelector('[data-wpm]'); // only where the big number shows Anschläge
      if (wpm) wpm.textContent = String(score.wpm);
      const verdict = text.ratings[ratingLevel(score.wpm)]!;
      find('[data-rating]').textContent = best > 0 && speed > best ? `${text.newBest} ${verdict}` : verdict;
      find('[data-accuracy]').textContent = `${score.accuracy} %`;
      find('[data-correct]').textContent = String(score.correctWords);
      find('[data-wrong]').textContent = String(score.wrongWords);
      find('[data-best-value]').textContent = fill(text.bestValue, { n: Math.max(best, speed) });
      const mistakes = find('[data-mistakes]');
      mistakes.textContent = fill(text.mistakes, { words: score.mistakes.slice(0, 15).join(', ') });
      mistakes.hidden = score.mistakes.length === 0;
      status.textContent = '';

      find('[data-area]').hidden = true;
      const result = find('[data-result]');
      result.hidden = false;
      // Focus the result itself, not the "Try again" button: someone still typing would press it by accident.
      result.focus({ preventScroll: true });
      result.scrollIntoView({ block: 'nearest' });
    }

    input.addEventListener('input', () => {
      if (finished) return;
      if (!startedAt) {
        if (input.value.trim() === '') {
          input.value = ''; // a space before the first word does nothing
          return;
        }
        startedAt = performance.now();
        ticker = window.setInterval(tick, 100);
      }

      // A space finishes a word. Normally there is at most one, but fast typing on a phone can bring more.
      // normalize('NFC'): an "ü" typed as u + ¨ (two characters) becomes the one character of the word list.
      const parts = input.value.normalize('NFC').split(' ');
      const current = parts.pop()!; // the word that is still being typed (after the last space)
      for (const part of parts) {
        if (part === '') continue; // two spaces in a row
        countKeys(part);
        submit(part);
        if (finished) return;
      }
      if (parts.length > 0) input.value = current;
      countKeys(current);

      // Mark the current word red as soon as the typed letters don't match it any more.
      spans[typed.length]!.classList.toggle('typo', !words[typed.length]!.startsWith(current));
    });

    input.addEventListener('keydown', (event) => {
      // Enter works like the space bar: add a space and let the code above handle it.
      if (event.key === 'Enter') {
        event.preventDefault();
        if (input.value.trim() === '') return;
        input.value += ' ';
        input.dispatchEvent(new Event('input'));
      }
    });

    const restart = () => {
      reset();
      input.focus();
    };
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        restart();
      }
    });
    find('[data-restart]').addEventListener('click', restart);
    find('[data-again]').addEventListener('click', restart);
    box.addEventListener('click', () => input.focus());

    for (const radio of root.querySelectorAll<HTMLInputElement>('input[name="duration"]')) {
      radio.addEventListener('change', () => {
        duration = Number(radio.value);
        reset();
        if (isDesktop()) input.focus();
      });
    }
    lesson?.addEventListener('change', () => {
      reset();
      if (isDesktop()) input.focus();
    });

    find('[data-share]').addEventListener('click', async () => {
      if (!lastScore) return;
      const message = fill(text.shareText, { wpm: lastScore.wpm, cpm: lastScore.cpm, accuracy: lastScore.accuracy });
      const url = location.origin + location.pathname;
      if (navigator.share) {
        await navigator.share({ text: message, url }).catch(() => {}); // the visitor closed the share menu
        return;
      }
      try {
        await navigator.clipboard.writeText(`${message} ${url}`);
        status.textContent = text.copied;
      } catch {
        status.textContent = `${message} ${url}`; // copying isn't allowed – show the text to copy by hand
      }
    });

    reset();
    // On computers the visitor can start typing right away. (Phones would pop up the keyboard – annoying.)
    if (isDesktop()) input.focus({ preventScroll: true });
  }
</script>
