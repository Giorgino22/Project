---
import ToolPage from '@tools/shared/components/ToolPage.astro';
import Wheel from '../components/Wheel.astro';
import { allPages, pages, site } from '../site';
import '../styles/wheel.css';

const page = pages.home;
---

<ToolPage site={site.id} page={page} allPages={allPages} themeColor={site.themeColor} adSlots={site.adSlots}>
  <Wheel preset={page.preset} storageKey="wheel:home" />
</ToolPage>
