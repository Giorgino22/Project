---
import SiteLayout from '@tools/shared/components/SiteLayout.astro';
import { allPages, site } from '../site';
import '../styles/wheel.css';
---

<SiteLayout site={site.id} title="Page not found" description="This page does not exist." path="/404/" noindex themeColor={site.themeColor}>
  <div class="container">
    <section class="page-intro">
      <h1>Page not found</h1>
      <p class="lead">This page doesn't exist. Try one of these:</p>
      <ul class="chip-list">{allPages.map((page) => <li><a href={page.path}>{page.name}</a></li>)}</ul>
    </section>
  </div>
</SiteLayout>
